<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="0" Creator="LiveGeometry">
  <Viewport Left="-20" Top="10.5" Right="20" Bottom="-10.5" />
  <Styles>
    <PointStyle Size="10" Fill="#FFFFFF64" IsFilled="true" Color="#FF000000" StrokeWidth="1" Name="FreePoint" />
    <PointStyle Size="9" Fill="#FFC0C0C0" IsFilled="true" Color="#FF000000" StrokeWidth="1" Name="DependentPoint" />
    <PointStyle Size="11" Fill="#FFFF5050" IsFilled="true" Color="#FF000000" StrokeWidth="1" Name="KeyPoint" />
    <LineStyle Color="#FF000000" StrokeWidth="2" Name="Triangle" />
    <LineStyle Color="#FF2F7BD6" StrokeWidth="1.5" Name="AngleBisector" />
    <LineStyle Color="#FF2E9E4F" StrokeWidth="1.5" Name="SideBisector" />
    <ShapeStyle Fill="#00FFFFFF" IsFilled="false" Color="#FF606060" StrokeWidth="1.5" Name="Circumcircle" />
    <ShapeStyle Fill="#00FFFFFF" IsFilled="false" Color="#FFE08A00" StrokeWidth="1.5" Name="TrilliumCircle" />
    <TextStyle FontSize="20" Color="#FF000000" FontFamily="Segoe UI" Bold="false" Italic="false" Underline="false" Name="PointName" />
    <TextStyle FontSize="16" Color="#FF404040" FontFamily="Segoe UI" Bold="false" Italic="false" Underline="false" Name="Note" />
  </Styles>
  <Figures>
    <FreePoint Name="A" Style="FreePoint" X="-7" Y="-3.5" />
    <FreePoint Name="B" Style="FreePoint" X="7.5" Y="-2" />
    <FreePoint Name="C" Style="FreePoint" X="1.5" Y="7.5" />
    <Segment Name="AB" Style="Triangle">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="BC" Style="Triangle">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </Segment>
    <Segment Name="CA" Style="Triangle">
      <Dependency Name="C" />
      <Dependency Name="A" />
    </Segment>
    <SegmentBisector Name="BisectorOfBC" Style="SideBisector">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </SegmentBisector>
    <SegmentBisector Name="BisectorOfAB" Style="SideBisector">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </SegmentBisector>
    <IntersectionPoint Name="O" Style="DependentPoint" Algorithm="IntersectLineAndLine">
      <Dependency Name="BisectorOfBC" />
      <Dependency Name="BisectorOfAB" />
    </IntersectionPoint>
    <Circle Name="Circumcircle" Style="Circumcircle">
      <Dependency Name="O" />
      <Dependency Name="A" />
    </Circle>
    <AngleBisector Name="BisectorOfA" Style="AngleBisector">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
    </AngleBisector>
    <AngleBisector Name="BisectorOfB" Style="AngleBisector">
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="A" />
    </AngleBisector>
    <IntersectionPoint Name="M" Style="KeyPoint" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="BisectorOfA" />
      <Dependency Name="Circumcircle" />
    </IntersectionPoint>
    <IntersectionPoint Name="I" Style="DependentPoint" Algorithm="IntersectLineAndLine">
      <Dependency Name="BisectorOfA" />
      <Dependency Name="BisectorOfB" />
    </IntersectionPoint>
    <Circle Name="TrilliumCircle" Style="TrilliumCircle">
      <Dependency Name="M" />
      <Dependency Name="B" />
    </Circle>
    <PointLabel Name="LabelA" Style="PointName" OffsetX="-1.1" OffsetY="0.2" ShowName="true" ShowCoordinates="false">
      <Dependency Name="A" />
    </PointLabel>
    <PointLabel Name="LabelB" Style="PointName" OffsetX="0.35" OffsetY="0.2" ShowName="true" ShowCoordinates="false">
      <Dependency Name="B" />
    </PointLabel>
    <PointLabel Name="LabelC" Style="PointName" OffsetX="-0.3" OffsetY="1.5" ShowName="true" ShowCoordinates="false">
      <Dependency Name="C" />
    </PointLabel>
    <PointLabel Name="LabelO" Style="PointName" OffsetX="-1.1" OffsetY="1.2" ShowName="true" ShowCoordinates="false">
      <Dependency Name="O" />
    </PointLabel>
    <PointLabel Name="LabelI" Style="PointName" OffsetX="-0.2" OffsetY="-0.4" ShowName="true" ShowCoordinates="false">
      <Dependency Name="I" />
    </PointLabel>
    <PointLabel Name="LabelM" Style="PointName" OffsetX="0.4" OffsetY="1.3" ShowName="true" ShowCoordinates="false">
      <Dependency Name="M" />
    </PointLabel>
    <Label Name="Note1" Style="Note" X="6" Y="-5.6" Text="Blue: angle bisectors.  Green: perpendicular bisectors of the sides." />
    <Label Name="Note2" Style="Note" X="6" Y="-6.6" Text="The bisector of angle A and the perpendicular bisector of BC" />
    <Label Name="Note3" Style="Note" X="6" Y="-7.4" Text="meet on the circumcircle, at M - the midpoint of arc BC." />
    <Label Name="Note4" Style="Note" X="6" Y="-8.4" Text="Orange circle, center M:  MB = MC = MI  (I is the incenter)." />
  </Figures>
</Drawing>
