<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry Snacks #28 (Prove it!), the generalized variant of a-right-triangle-and-its-incircle.lgf, shown by the
     puzzle page's Generalize switch (see "Generalize" in docs/snacks.md): the statement's "right angled" is struck out.
     A is a hidden fixed point and the base AX a hidden segment along the bottom. Two handles: C slides along AX as in
     the book's drawing, and B, which there slid up the perpendicular at A, is free inside a hidden rectangle above the
     base, so ABC is any triangle. Both start where the book's drawing has them. The incircle is the circle about I,
     where the bisectors of the angles at A and at C meet, through the foot of the perpendicular from I to AC; there is
     no mark of a right angle. The area is s times r wherever B and C are. -->
<Drawing Version="1">
  <Viewport Left="-0.7" Top="6.7" Right="6.7" Bottom="-0.7" />
  <Scene Left="-0.7" Top="6.7" Right="6.7" Bottom="-0.7" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
    <ShapeStyle Name="RedFrame" Color="#FFEF303F" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFF0616C" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="X" Visible="false" Locked="true" X="6" Y="0" />
    <Segment Name="AX" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="X" />
    </Segment>
    <PointOnFigure Name="C" Style="Handle" X="4.2" Y="0" Parameter="0.7">
      <Dependency Name="AX" />
    </PointOnFigure>
    <!-- the room B moves in: above the base, within the scene -->
    <FreePoint Name="R1" Visible="false" Locked="true" X="-0.5" Y="0.6" />
    <FreePoint Name="R2" Visible="false" Locked="true" X="6.5" Y="0.6" />
    <FreePoint Name="R3" Visible="false" Locked="true" X="6.5" Y="6.5" />
    <FreePoint Name="R4" Visible="false" Locked="true" X="-0.5" Y="6.5" />
    <Polygon Name="Room" Visible="false">
      <Dependency Name="R1" />
      <Dependency Name="R2" />
      <Dependency Name="R3" />
      <Dependency Name="R4" />
    </Polygon>
    <PointInRegion Name="B" Style="Handle" X="0" Y="3.12">
      <Dependency Name="Room" />
    </PointInRegion>
    <Polygon Name="ABC" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
    </Polygon>
    <AngleBisector Name="bisectorA" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="C" />
      <Dependency Name="B" />
    </AngleBisector>
    <AngleBisector Name="bisectorC" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="B" />
      <Dependency Name="A" />
    </AngleBisector>
    <IntersectionPoint Name="I" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="bisectorA" />
      <Dependency Name="bisectorC" />
    </IntersectionPoint>
    <PerpendicularLine Name="down" Visible="false">
      <Dependency Name="AX" />
      <Dependency Name="I" />
    </PerpendicularLine>
    <IntersectionPoint Name="F" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="down" />
      <Dependency Name="AX" />
    </IntersectionPoint>
    <Circle Name="incircle" Style="RedFrame">
      <Dependency Name="I" />
      <Dependency Name="F" />
    </Circle>
  </Figures>
</Drawing>
