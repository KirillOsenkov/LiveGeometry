<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry Snacks #3 (What Fraction is Shaded?), drawn by hand as a ruler-and-compass construction.
     A square ABCD on the hidden points A and B: perpendiculars to AB at A and B; D is where the perpendicular at A
     meets the circle about A through B, and C is where the parallel to AB through D meets the perpendicular at B. The
     left and top sides are quartered by midpoints of midpoints, every quarter point is joined to B, and the triangle
     on the second quarter of the left side is shaded: it is an eighth of the square.
     A fixed figure: the statement says a square, so there is no handle (issue #6, 2026-11-08; until then D slid along
     the perpendicular at A and the square became a rectangle). -->
<Drawing Version="1">
  <Viewport Left="-1.6" Top="6.6" Right="5.6" Bottom="-0.6" />
  <Scene Left="-1.6" Top="6.6" Right="5.6" Bottom="-0.6" />
  <Styles>
    <ShapeStyle Name="Red" Color="#FF000000" StrokeWidth="3" Fill="#FFEF303F">
      <Dark Color="#FFE8EBF0" Fill="#FFD9333F" />
    </ShapeStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
    <LineStyle Name="Ink" Color="#FF000000" StrokeWidth="3">
      <Dark Color="#FFE8EBF0" />
    </LineStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="B" Visible="false" Locked="true" X="4" Y="0" />
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <PerpendicularLine Name="a" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="A" />
    </PerpendicularLine>
    <PerpendicularLine Name="b" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="B" />
    </PerpendicularLine>
    <Circle Name="cA" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <IntersectionPoint Name="D" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="a" />
      <Dependency Name="cA" />
    </IntersectionPoint>
    <ParallelLine Name="d" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="D" />
    </ParallelLine>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="d" />
      <Dependency Name="b" />
    </IntersectionPoint>
    <!-- quarter points of the left side AD and of the top side DC -->
    <MidPoint Name="M1" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </MidPoint>
    <MidPoint Name="M0" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="M1" />
    </MidPoint>
    <MidPoint Name="M2" Visible="false">
      <Dependency Name="M1" />
      <Dependency Name="D" />
    </MidPoint>
    <MidPoint Name="N1" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="N0" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="N1" />
    </MidPoint>
    <MidPoint Name="N2" Visible="false">
      <Dependency Name="N1" />
      <Dependency Name="C" />
    </MidPoint>
    <Polygon Name="ABCD" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <Segment Name="M0B" Style="Ink">
      <Dependency Name="M0" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="M1B" Style="Ink">
      <Dependency Name="M1" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="M2B" Style="Ink">
      <Dependency Name="M2" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="DB" Style="Ink">
      <Dependency Name="D" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="N0B" Style="Ink">
      <Dependency Name="N0" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="N1B" Style="Ink">
      <Dependency Name="N1" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="N2B" Style="Ink">
      <Dependency Name="N2" />
      <Dependency Name="B" />
    </Segment>
    <Polygon Name="Shaded" Style="Red">
      <Dependency Name="B" />
      <Dependency Name="M0" />
      <Dependency Name="M1" />
    </Polygon>
  </Figures>
</Drawing>
