<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry Snacks #38 (What's the Area?), drawn by hand as a ruler-and-compass construction.
     The figure is fixed by the statement (both segments 5 cm), so nothing is dragged.
     The hidden points O and E are a unit apart (one of the five equal parts). The vertical segment is stepped off on
     the ray OE with circles of radius OE: V2, V3, V4 and V5, its top. The horizontal segment lies on the perpendicular
     to OE at O; its end H is where the circle of radius OV5 about O meets that perpendicular, five units out. The five
     equal parts of OH come from the parallels to V5H through E, V2, V3 and V4 (the intercept theorem); the first on
     one segment is joined to the last on the other, and so on. The red quadrilateral is O, H2, the crossing X of the
     lines V4H2 and V2H4, and V2. -->
<Drawing Version="1">
  <Viewport Left="-0.8" Top="5.8" Right="5.8" Bottom="-0.8" />
  <Scene Left="-0.8" Top="5.8" Right="5.8" Bottom="-0.8" />
  <Styles>
    <PointStyle Name="Dot" Size="11" Fill="#FF000000" Color="#FF000000" StrokeWidth="0">
      <Dark Fill="#FFE8EBF0" Color="#FFE8EBF0" />
    </PointStyle>
    <ShapeStyle Name="Red" Color="#FF000000" StrokeWidth="3" Fill="#FFEF303F">
      <Dark Color="#FFE8EBF0" Fill="#FFD9333F" />
    </ShapeStyle>
    <LineStyle Name="Ink" Color="#FF000000" StrokeWidth="3">
      <Dark Color="#FFE8EBF0" />
    </LineStyle>
  </Styles>
  <Figures>
    <FreePoint Name="O" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="E" Visible="false" Locked="true" X="0" Y="1" />
    <Ray Name="up" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
    </Ray>
    <CircleByRadius Name="c2" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="E" />
    </CircleByRadius>
    <IntersectionPoint Name="V2" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c2" />
    </IntersectionPoint>
    <CircleByRadius Name="c3" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="V2" />
    </CircleByRadius>
    <IntersectionPoint Name="V3" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c3" />
    </IntersectionPoint>
    <CircleByRadius Name="c4" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="V3" />
    </CircleByRadius>
    <IntersectionPoint Name="V4" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c4" />
    </IntersectionPoint>
    <CircleByRadius Name="c5" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="V4" />
    </CircleByRadius>
    <IntersectionPoint Name="V5" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c5" />
    </IntersectionPoint>
    <PerpendicularLine Name="across" Visible="false">
      <Dependency Name="up" />
      <Dependency Name="O" />
    </PerpendicularLine>
    <Circle Name="c5across" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="V5" />
    </Circle>
    <IntersectionPoint Name="H" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="across" />
      <Dependency Name="c5across" />
    </IntersectionPoint>
    <Segment Name="vertical" Style="Ink">
      <Dependency Name="O" />
      <Dependency Name="V5" />
    </Segment>
    <Segment Name="horizontal" Style="Ink">
      <Dependency Name="O" />
      <Dependency Name="H" />
    </Segment>
    <LineTwoPoints Name="V5H" Visible="false">
      <Dependency Name="V5" />
      <Dependency Name="H" />
    </LineTwoPoints>
    <ParallelLine Name="p1" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="E" />
    </ParallelLine>
    <ParallelLine Name="p2" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="V2" />
    </ParallelLine>
    <ParallelLine Name="p3" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="V3" />
    </ParallelLine>
    <ParallelLine Name="p4" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="V4" />
    </ParallelLine>
    <IntersectionPoint Name="H1" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p1" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="H2" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p2" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="H3" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p3" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="H4" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p4" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="Od" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="vertical" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="V1" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p1" />
      <Dependency Name="vertical" />
    </IntersectionPoint>
    <Segment Name="s1" Style="Ink">
      <Dependency Name="V5" />
      <Dependency Name="H1" />
    </Segment>
    <Segment Name="s2" Style="Ink">
      <Dependency Name="V4" />
      <Dependency Name="H2" />
    </Segment>
    <Segment Name="s3" Style="Ink">
      <Dependency Name="V3" />
      <Dependency Name="H3" />
    </Segment>
    <Segment Name="s4" Style="Ink">
      <Dependency Name="V2" />
      <Dependency Name="H4" />
    </Segment>
    <Segment Name="s5" Style="Ink">
      <Dependency Name="V1" />
      <Dependency Name="H" />
    </Segment>
    <IntersectionPoint Name="X" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s2" />
      <Dependency Name="s4" />
    </IntersectionPoint>
    <Polygon Name="red" Style="Red">
      <Dependency Name="O" />
      <Dependency Name="H2" />
      <Dependency Name="X" />
      <Dependency Name="V2" />
    </Polygon>
  </Figures>
</Drawing>
