<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry Snacks #38 (What's the Area?), drawn by hand as a ruler-and-compass construction.
     The hidden points O and E are a unit apart (one of the five equal parts). The vertical segment is stepped off on
     the ray OE with circles of radius OE: V2, V3, V4 and V5, its top. The horizontal segment lies on the perpendicular
     to OE at O; its end H is the handle, sliding along a hidden track from P1 (one unit from O, where the unit circle
     meets the perpendicular) to T (seven units from O: the circle of radius OV5 about O gives T5 at five units, and the
     circle of radius OV2 about T5 gives T). The five equal parts of OH come from the parallels to V5H through E, V2,
     V3 and V4 (the intercept theorem); the first on one segment is joined to the last on the other, and so on. The red
     quadrilateral is O, H2, the crossing X of the lines V4H2 and V2H4, and V2. The book has both segments 5 cm; H
     starts there and stretches the horizontal one from one unit to seven. -->
<Drawing Version="1">
  <Viewport Left="-1.2" Top="7" Right="8.2" Bottom="-1.6" />
  <Scene Left="-1.2" Top="7" Right="8.2" Bottom="-1.6" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <PointStyle Name="Dot" Size="11" Fill="#FF000000" Color="#FF000000" StrokeWidth="0">
      <Dark Fill="#FFE8EBF0" Color="#FFE8EBF0" />
    </PointStyle>
    <ShapeStyle Name="Red" Color="#FF000000" StrokeWidth="3" Fill="#FFEF303F">
      <Dark Color="#FFE8EBF0" Fill="#FFD9333F" />
    </ShapeStyle>
    <LineStyle Name="Ink" Color="#FF000000" StrokeWidth="3">
      <Dark Color="#FFE8EBF0" />
    </LineStyle>
  </Styles>
  <Figures>
    <FreePoint Name="O" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="E" Visible="false" Locked="true" X="0" Y="1" />
    <Ray Name="up" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
    </Ray>
    <Circle Name="unit" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
    </Circle>
    <CircleByRadius Name="c2" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="E" />
    </CircleByRadius>
    <IntersectionPoint Name="V2" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c2" />
    </IntersectionPoint>
    <CircleByRadius Name="c3" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="V2" />
    </CircleByRadius>
    <IntersectionPoint Name="V3" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c3" />
    </IntersectionPoint>
    <CircleByRadius Name="c4" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="V3" />
    </CircleByRadius>
    <IntersectionPoint Name="V4" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c4" />
    </IntersectionPoint>
    <CircleByRadius Name="c5" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="E" />
      <Dependency Name="V4" />
    </CircleByRadius>
    <IntersectionPoint Name="V5" Style="Dot" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="up" />
      <Dependency Name="c5" />
    </IntersectionPoint>
    <PerpendicularLine Name="across" Visible="false">
      <Dependency Name="up" />
      <Dependency Name="O" />
    </PerpendicularLine>
    <IntersectionPoint Name="P1" Visible="false" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="across" />
      <Dependency Name="unit" />
    </IntersectionPoint>
    <Circle Name="c5across" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="V5" />
    </Circle>
    <IntersectionPoint Name="T5" Visible="false" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="across" />
      <Dependency Name="c5across" />
    </IntersectionPoint>
    <CircleByRadius Name="c7" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="V2" />
      <Dependency Name="T5" />
    </CircleByRadius>
    <IntersectionPoint Name="T" Visible="false" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="across" />
      <Dependency Name="c7" />
    </IntersectionPoint>
    <Segment Name="track" Visible="false">
      <Dependency Name="P1" />
      <Dependency Name="T" />
    </Segment>
    <PointOnFigure Name="H" Style="Handle" X="5" Y="0" Parameter="0.6666666667">
      <Dependency Name="track" />
    </PointOnFigure>
    <Segment Name="vertical" Style="Ink">
      <Dependency Name="O" />
      <Dependency Name="V5" />
    </Segment>
    <Segment Name="horizontal" Style="Ink">
      <Dependency Name="O" />
      <Dependency Name="H" />
    </Segment>
    <LineTwoPoints Name="V5H" Visible="false">
      <Dependency Name="V5" />
      <Dependency Name="H" />
    </LineTwoPoints>
    <ParallelLine Name="p1" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="E" />
    </ParallelLine>
    <ParallelLine Name="p2" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="V2" />
    </ParallelLine>
    <ParallelLine Name="p3" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="V3" />
    </ParallelLine>
    <ParallelLine Name="p4" Visible="false">
      <Dependency Name="V5H" />
      <Dependency Name="V4" />
    </ParallelLine>
    <IntersectionPoint Name="H1" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p1" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="H2" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p2" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="H3" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p3" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="H4" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p4" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="Od" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="vertical" />
      <Dependency Name="horizontal" />
    </IntersectionPoint>
    <IntersectionPoint Name="V1" Style="Dot" Algorithm="IntersectLineAndLine">
      <Dependency Name="p1" />
      <Dependency Name="vertical" />
    </IntersectionPoint>
    <Segment Name="s1" Style="Ink">
      <Dependency Name="V5" />
      <Dependency Name="H1" />
    </Segment>
    <Segment Name="s2" Style="Ink">
      <Dependency Name="V4" />
      <Dependency Name="H2" />
    </Segment>
    <Segment Name="s3" Style="Ink">
      <Dependency Name="V3" />
      <Dependency Name="H3" />
    </Segment>
    <Segment Name="s4" Style="Ink">
      <Dependency Name="V2" />
      <Dependency Name="H4" />
    </Segment>
    <Segment Name="s5" Style="Ink">
      <Dependency Name="V1" />
      <Dependency Name="H" />
    </Segment>
    <IntersectionPoint Name="X" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s2" />
      <Dependency Name="s4" />
    </IntersectionPoint>
    <Polygon Name="red" Style="Red">
      <Dependency Name="O" />
      <Dependency Name="H2" />
      <Dependency Name="X" />
      <Dependency Name="V2" />
    </Polygon>
  </Figures>
</Drawing>
