<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry Snacks #2 (What Fraction is Shaded?), drawn by hand as a ruler-and-compass construction.
     An equilateral triangle ABC on the hidden base points A and B; the apex C is where the circles of the base's
     radius about A and B cross. M is the midpoint of AC and N the midpoint of CB; the shaded triangle is AMN.
     A fixed figure: the statement says the triangle is equilateral, so there is no handle (issue #5, 2026-11-08;
     until then C was free and the triangle became any triangle). -->
<Drawing Version="1">
  <Viewport Left="-1.1" Top="5.5" Right="5.1" Bottom="-0.6" />
  <Scene Left="-1.1" Top="5.5" Right="5.1" Bottom="-0.6" />
  <Styles>
    <ShapeStyle Name="Red" Color="#FF000000" StrokeWidth="3" Fill="#FFEF303F">
      <Dark Color="#FFE8EBF0" Fill="#FFD9333F" />
    </ShapeStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="B" Visible="false" Locked="true" X="4" Y="0" />
    <Circle Name="cA" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <Circle Name="cB" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Circle>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectCircleAndCircle2">
      <Dependency Name="cA" />
      <Dependency Name="cB" />
    </IntersectionPoint>
    <MidPoint Name="M" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="N" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="B" />
    </MidPoint>
    <Polygon Name="ABC" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
    </Polygon>
    <Polygon Name="AMN" Style="Red">
      <Dependency Name="A" />
      <Dependency Name="M" />
      <Dependency Name="N" />
    </Polygon>
  </Figures>
</Drawing>
