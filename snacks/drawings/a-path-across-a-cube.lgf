<?xml version="1.0" encoding="utf-8"?>
<!-- More Geometry Snacks #7 (3D Geometry), drawn by hand as a ruler-and-compass construction.
     The cube cannot be drawn flat, so this is its net, three faces of 4 by 4: the front face ABCD on the hidden points
     A and B (perpendiculars at A and B cut by the circles of radius AB), the right face BEGC beside it, sharing the edge
     BC, and the top face DCIH above the front face, sharing the edge DC; the other corners are reflections in a point
     (E is A reflected in B, and so on). The grid points are midpoints of midpoints and the grid lines join them. The
     start point S is a grid point of the front face and the four blue points are grid points of the right face.
     The handle P is a point of the right face. The path across the shared edge is the segment SP. For the path across
     the top face the right face is unfolded off the top face instead, into the dashed square CGJI: there P appears as
     P', its image under the quarter turn about C, built as two reflections (in the line DG, then in the diagonal CJ),
     and the path is the segment SP'. The faint circle about S through P says which path is shorter: the top path is
     shorter exactly when P' is inside it. The top path is a path of the surface only while SP' stays inside the three
     faces; where it cuts through the corner C the direct path is the shorter one anyway. -->
<Drawing Version="1">
  <Viewport Left="-0.6" Top="8.6" Right="8.6" Bottom="-0.6" />
  <Scene Left="-0.6" Top="8.6" Right="8.6" Bottom="-0.6" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <PointStyle Name="BlueDot" Size="11" Fill="#FF0000FF" Color="#FF0000FF" StrokeWidth="1">
      <Dark Fill="#FF9DA3FF" Color="#FF9DA3FF" />
    </PointStyle>
    <PointStyle Name="BlueRing" Size="11" Fill="#FFFFFFFF" Color="#FF0000FF" StrokeWidth="2">
      <Dark Fill="#FF1E2228" Color="#FF9DA3FF" />
    </PointStyle>
    <PointStyle Name="Anchor" Size="1" Fill="#00000000" Color="#00000000" StrokeWidth="0" />
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
    <ShapeStyle Name="Ghost" Color="#FF000000" StrokeWidth="2.5" Dash="Dash" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
    <LineStyle Name="Grid" Color="#FFA0A0A0" StrokeWidth="1.25">
      <Dark Color="#FF6B7280" />
    </LineStyle>
    <LineStyle Name="BlueLine" Color="#FF0000FF" StrokeWidth="3">
      <Dark Color="#FF9DA3FF" />
    </LineStyle>
    <LineStyle Name="BlueDashed" Color="#FF0000FF" StrokeWidth="3" Dash="Dash">
      <Dark Color="#FF9DA3FF" />
    </LineStyle>
    <LineStyle Name="Faint" Color="#FFA0A0A0" StrokeWidth="1.25" Dash="Dash">
      <Dark Color="#FF6B7280" />
    </LineStyle>
    <TextStyle Name="Note" FontSize="15" Color="#FF6B7280" FontFamily="Segoe UI">
      <Dark Color="#FF9CA3AF" />
    </TextStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="B" Visible="false" Locked="true" X="4" Y="0" />
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <PerpendicularLine Name="a" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="A" />
    </PerpendicularLine>
    <PerpendicularLine Name="b" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="B" />
    </PerpendicularLine>
    <Circle Name="ca" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <Circle Name="cb" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Circle>
    <IntersectionPoint Name="D" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="a" />
      <Dependency Name="ca" />
    </IntersectionPoint>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="b" />
      <Dependency Name="cb" />
    </IntersectionPoint>
    <ReflectedPoint Name="E" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </ReflectedPoint>
    <ReflectedPoint Name="G" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="C" />
    </ReflectedPoint>
    <ReflectedPoint Name="H" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </ReflectedPoint>
    <ReflectedPoint Name="I" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </ReflectedPoint>
    <ReflectedPoint Name="J" Visible="false">
      <Dependency Name="E" />
      <Dependency Name="G" />
    </ReflectedPoint>
    <!-- grid points: midpoints of midpoints along the edges -->
    <MidPoint Name="B2" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </MidPoint>
    <MidPoint Name="B1" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B2" />
    </MidPoint>
    <MidPoint Name="B3" Visible="false">
      <Dependency Name="B2" />
      <Dependency Name="B" />
    </MidPoint>
    <MidPoint Name="T2" Visible="false">
      <Dependency Name="H" />
      <Dependency Name="I" />
    </MidPoint>
    <MidPoint Name="T1" Visible="false">
      <Dependency Name="H" />
      <Dependency Name="T2" />
    </MidPoint>
    <MidPoint Name="T3" Visible="false">
      <Dependency Name="T2" />
      <Dependency Name="I" />
    </MidPoint>
    <MidPoint Name="L2" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </MidPoint>
    <MidPoint Name="L1" Style="Anchor">
      <Dependency Name="A" />
      <Dependency Name="L2" />
    </MidPoint>
    <MidPoint Name="L3" Visible="false">
      <Dependency Name="L2" />
      <Dependency Name="D" />
    </MidPoint>
    <MidPoint Name="Q2" Visible="false">
      <Dependency Name="E" />
      <Dependency Name="G" />
    </MidPoint>
    <MidPoint Name="Q1" Visible="false">
      <Dependency Name="E" />
      <Dependency Name="Q2" />
    </MidPoint>
    <MidPoint Name="Q3" Visible="false">
      <Dependency Name="Q2" />
      <Dependency Name="G" />
    </MidPoint>
    <MidPoint Name="U2" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="E" />
    </MidPoint>
    <MidPoint Name="U1" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="U2" />
    </MidPoint>
    <MidPoint Name="U3" Visible="false">
      <Dependency Name="U2" />
      <Dependency Name="E" />
    </MidPoint>
    <MidPoint Name="V2" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="G" />
    </MidPoint>
    <MidPoint Name="V1" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="V2" />
    </MidPoint>
    <MidPoint Name="V3" Visible="false">
      <Dependency Name="V2" />
      <Dependency Name="G" />
    </MidPoint>
    <MidPoint Name="W2" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="H" />
    </MidPoint>
    <MidPoint Name="W1" Style="Anchor">
      <Dependency Name="D" />
      <Dependency Name="W2" />
    </MidPoint>
    <MidPoint Name="W3" Visible="false">
      <Dependency Name="W2" />
      <Dependency Name="H" />
    </MidPoint>
    <MidPoint Name="X2" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="I" />
    </MidPoint>
    <MidPoint Name="X1" Style="Anchor">
      <Dependency Name="C" />
      <Dependency Name="X2" />
    </MidPoint>
    <MidPoint Name="X3" Visible="false">
      <Dependency Name="X2" />
      <Dependency Name="I" />
    </MidPoint>
    <!-- the faces -->
    <Polygon Name="RightAgain" Style="Ghost">
      <Dependency Name="C" />
      <Dependency Name="G" />
      <Dependency Name="J" />
      <Dependency Name="I" />
    </Polygon>
    <Polygon Name="Front" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <Polygon Name="Right" Style="Frame">
      <Dependency Name="B" />
      <Dependency Name="E" />
      <Dependency Name="G" />
      <Dependency Name="C" />
    </Polygon>
    <Polygon Name="Top" Style="Frame">
      <Dependency Name="D" />
      <Dependency Name="C" />
      <Dependency Name="I" />
      <Dependency Name="H" />
    </Polygon>
    <!-- the grid lines -->
    <Segment Name="g1" Style="Grid">
      <Dependency Name="B1" />
      <Dependency Name="T1" />
    </Segment>
    <Segment Name="g2" Style="Grid">
      <Dependency Name="B2" />
      <Dependency Name="T2" />
    </Segment>
    <Segment Name="g3" Style="Grid">
      <Dependency Name="B3" />
      <Dependency Name="T3" />
    </Segment>
    <Segment Name="g4" Style="Grid">
      <Dependency Name="L1" />
      <Dependency Name="Q1" />
    </Segment>
    <Segment Name="g5" Style="Grid">
      <Dependency Name="L2" />
      <Dependency Name="Q2" />
    </Segment>
    <Segment Name="g6" Style="Grid">
      <Dependency Name="L3" />
      <Dependency Name="Q3" />
    </Segment>
    <Segment Name="g7" Style="Grid">
      <Dependency Name="U1" />
      <Dependency Name="V1" />
    </Segment>
    <Segment Name="g8" Style="Grid">
      <Dependency Name="U2" />
      <Dependency Name="V2" />
    </Segment>
    <Segment Name="g9" Style="Grid">
      <Dependency Name="U3" />
      <Dependency Name="V3" />
    </Segment>
    <Segment Name="g10" Style="Grid">
      <Dependency Name="W1" />
      <Dependency Name="X1" />
    </Segment>
    <Segment Name="g11" Style="Grid">
      <Dependency Name="W2" />
      <Dependency Name="X2" />
    </Segment>
    <Segment Name="g12" Style="Grid">
      <Dependency Name="W3" />
      <Dependency Name="X3" />
    </Segment>
    <!-- the start point and the four points of the right face, grid points -->
    <IntersectionPoint Name="S" Style="BlueDot" Algorithm="IntersectLineAndLine">
      <Dependency Name="g1" />
      <Dependency Name="g6" />
    </IntersectionPoint>
    <IntersectionPoint Name="D1" Style="BlueDot" Algorithm="IntersectLineAndLine">
      <Dependency Name="g8" />
      <Dependency Name="g6" />
    </IntersectionPoint>
    <IntersectionPoint Name="D2" Style="BlueDot" Algorithm="IntersectLineAndLine">
      <Dependency Name="g9" />
      <Dependency Name="g6" />
    </IntersectionPoint>
    <IntersectionPoint Name="D3" Style="BlueDot" Algorithm="IntersectLineAndLine">
      <Dependency Name="g8" />
      <Dependency Name="g5" />
    </IntersectionPoint>
    <IntersectionPoint Name="D4" Style="BlueDot" Algorithm="IntersectLineAndLine">
      <Dependency Name="g9" />
      <Dependency Name="g5" />
    </IntersectionPoint>
    <!-- the handle and its image in the unfolding over the top -->
    <PointInRegion Name="P" Style="Handle" X="6.5" Y="2.5">
      <Dependency Name="Right" />
    </PointInRegion>
    <LineTwoPoints Name="DG" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="G" />
    </LineTwoPoints>
    <LineTwoPoints Name="CJ" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="J" />
    </LineTwoPoints>
    <ReflectedPoint Name="P1" Visible="false">
      <Dependency Name="P" />
      <Dependency Name="DG" />
    </ReflectedPoint>
    <ReflectedPoint Name="P2" Style="BlueRing">
      <Dependency Name="P1" />
      <Dependency Name="CJ" />
    </ReflectedPoint>
    <Circle Name="reach" Style="Faint">
      <Dependency Name="S" />
      <Dependency Name="P" />
    </Circle>
    <Segment Name="EdgePath" Style="BlueLine">
      <Dependency Name="S" />
      <Dependency Name="P" />
    </Segment>
    <Segment Name="TopPath" Style="BlueDashed">
      <Dependency Name="S" />
      <Dependency Name="P2" />
    </Segment>
    <!-- the names of the faces, in the cell above each anchor -->
    <IntersectionPoint Name="R1" Style="Anchor" Algorithm="IntersectLineAndLine">
      <Dependency Name="b" />
      <Dependency Name="g4" />
    </IntersectionPoint>
    <AttachedLabel Name="FrontName" Style="Note" OffsetX="8" OffsetY="4" Text="front">
      <Dependency Name="L1" />
    </AttachedLabel>
    <AttachedLabel Name="RightName" Style="Note" OffsetX="8" OffsetY="4" Text="right">
      <Dependency Name="R1" />
    </AttachedLabel>
    <AttachedLabel Name="TopName" Style="Note" OffsetX="8" OffsetY="4" Text="top">
      <Dependency Name="W1" />
    </AttachedLabel>
    <AttachedLabel Name="RightAgainName" Style="Note" OffsetX="8" OffsetY="4" Text="right, over the top">
      <Dependency Name="X1" />
    </AttachedLabel>
  </Figures>
</Drawing>
