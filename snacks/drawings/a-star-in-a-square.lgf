<?xml version="1.0" encoding="utf-8"?>
<!-- More Geometry Snacks #11 (What Fraction is Shaded?), drawn by hand as a ruler-and-compass construction.
     The bottom side AB is fixed on the hidden points A and B. The square ABCD: D and C are where the perpendiculars to
     AB at A and B meet the circles of radius AB about them. The star is the pentagram on D and the four midpoints Mt,
     Mr, Mb, Ml of the sides, drawn as the ten-cornered polygon of its tips and the crossings of its chords, with the
     five chords over it.
     A fixed figure: the statement says a square, so there is no handle (2026-11-08, with issues #5 and #6; until
     then D slid along the top line and the square leaned into a parallelogram). -->
<Drawing Version="1">
  <Viewport Left="-2.6" Top="6.4" Right="8.6" Bottom="-2.4" />
  <Scene Left="-2.6" Top="6.4" Right="8.6" Bottom="-2.4" />
  <Styles>
    <ShapeStyle Name="Blue" Color="#FF0000FF" StrokeWidth="3" Fill="#FFB9B9FF">
      <Dark Color="#FF9DA3FF" Fill="#FF7F86D6" />
    </ShapeStyle>
    <LineStyle Name="BlueLine" Color="#FF0000FF" StrokeWidth="3">
      <Dark Color="#FF9DA3FF" />
    </LineStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="B" Visible="false" Locked="true" X="4" Y="0" />
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <PerpendicularLine Name="a" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="A" />
    </PerpendicularLine>
    <PerpendicularLine Name="b" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="B" />
    </PerpendicularLine>
    <Circle Name="ca" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <Circle Name="cb" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Circle>
    <IntersectionPoint Name="D" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="a" />
      <Dependency Name="ca" />
    </IntersectionPoint>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="b" />
      <Dependency Name="cb" />
    </IntersectionPoint>
    <MidPoint Name="Mb" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </MidPoint>
    <Polygon Name="ABCD" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <MidPoint Name="Mt" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="Mr" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="Ml" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </MidPoint>
    <!-- the five chords of the pentagram D, Mt, Mr, Mb, Ml -->
    <Segment Name="s1" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="Mr" />
    </Segment>
    <Segment Name="s2" Visible="false">
      <Dependency Name="Mr" />
      <Dependency Name="Ml" />
    </Segment>
    <Segment Name="s3" Visible="false">
      <Dependency Name="Ml" />
      <Dependency Name="Mt" />
    </Segment>
    <Segment Name="s4" Visible="false">
      <Dependency Name="Mt" />
      <Dependency Name="Mb" />
    </Segment>
    <Segment Name="s5" Visible="false">
      <Dependency Name="Mb" />
      <Dependency Name="D" />
    </Segment>
    <IntersectionPoint Name="I1" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s1" />
      <Dependency Name="s3" />
    </IntersectionPoint>
    <IntersectionPoint Name="I2" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s4" />
      <Dependency Name="s1" />
    </IntersectionPoint>
    <IntersectionPoint Name="I3" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s2" />
      <Dependency Name="s4" />
    </IntersectionPoint>
    <IntersectionPoint Name="I4" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s5" />
      <Dependency Name="s2" />
    </IntersectionPoint>
    <IntersectionPoint Name="I5" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s3" />
      <Dependency Name="s5" />
    </IntersectionPoint>
    <Polygon Name="star" Style="Blue">
      <Dependency Name="D" />
      <Dependency Name="I1" />
      <Dependency Name="Mt" />
      <Dependency Name="I2" />
      <Dependency Name="Mr" />
      <Dependency Name="I3" />
      <Dependency Name="Mb" />
      <Dependency Name="I4" />
      <Dependency Name="Ml" />
      <Dependency Name="I5" />
    </Polygon>
    <Segment Name="DMr" Style="BlueLine">
      <Dependency Name="D" />
      <Dependency Name="Mr" />
    </Segment>
    <Segment Name="MrMl" Style="BlueLine">
      <Dependency Name="Mr" />
      <Dependency Name="Ml" />
    </Segment>
    <Segment Name="MlMt" Style="BlueLine">
      <Dependency Name="Ml" />
      <Dependency Name="Mt" />
    </Segment>
    <Segment Name="MtMb" Style="BlueLine">
      <Dependency Name="Mt" />
      <Dependency Name="Mb" />
    </Segment>
    <Segment Name="MbD" Style="BlueLine">
      <Dependency Name="Mb" />
      <Dependency Name="D" />
    </Segment>
  </Figures>
</Drawing>
