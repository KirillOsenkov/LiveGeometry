<?xml version="1.0" encoding="utf-8"?>
<!-- More Geometry Snacks #11 (What Fraction is Shaded?), drawn by hand as a ruler-and-compass construction.
     The bottom side AB is fixed on the hidden points A and B. The top-left corner D is the handle: it slides along a
     hidden track on the parallel to AB a side's length above it (from two sides to the left of A to one side to the
     right), so the square leans into a parallelogram either way; C is where the parallel to AD through B meets that
     line. The star is the pentagram on D and the four midpoints Mt, Mr, Mb, Ml of the sides, drawn as the ten-cornered
     polygon of its tips and the crossings of its chords, with the five chords over it. Its fraction of the
     parallelogram is the same wherever D is; the handle starts at the square. -->
<Drawing Version="1">
  <Viewport Left="-2.6" Top="6.4" Right="8.6" Bottom="-2.4" />
  <Scene Left="-2.6" Top="6.4" Right="8.6" Bottom="-2.4" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Blue" Color="#FF0000FF" StrokeWidth="3" Fill="#FFB9B9FF">
      <Dark Color="#FF9DA3FF" Fill="#FF7F86D6" />
    </ShapeStyle>
    <LineStyle Name="BlueLine" Color="#FF0000FF" StrokeWidth="3">
      <Dark Color="#FF9DA3FF" />
    </LineStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <FreePoint Name="B" Visible="false" Locked="true" X="4" Y="0" />
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <PerpendicularLine Name="a" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="A" />
    </PerpendicularLine>
    <PerpendicularLine Name="b" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="B" />
    </PerpendicularLine>
    <Circle Name="ca" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <Circle Name="cb" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Circle>
    <IntersectionPoint Name="D0" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="a" />
      <Dependency Name="ca" />
    </IntersectionPoint>
    <IntersectionPoint Name="C0" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="b" />
      <Dependency Name="cb" />
    </IntersectionPoint>
    <ParallelLine Name="top" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="D0" />
    </ParallelLine>
    <MidPoint Name="Mb" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </MidPoint>
    <!-- the track: half a side's radius about D0 reaches two sides to the left of A -->
    <CircleByRadius Name="half" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="Mb" />
      <Dependency Name="D0" />
    </CircleByRadius>
    <IntersectionPoint Name="T0" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="top" />
      <Dependency Name="half" />
    </IntersectionPoint>
    <Segment Name="track" Visible="false">
      <Dependency Name="T0" />
      <Dependency Name="C0" />
    </Segment>
    <PointOnFigure Name="D" Style="Handle" X="0" Y="4" Parameter="0.3333333333">
      <Dependency Name="track" />
    </PointOnFigure>
    <LineTwoPoints Name="ad" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </LineTwoPoints>
    <ParallelLine Name="bc" Visible="false">
      <Dependency Name="ad" />
      <Dependency Name="B" />
    </ParallelLine>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="bc" />
      <Dependency Name="top" />
    </IntersectionPoint>
    <Polygon Name="ABCD" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <MidPoint Name="Mt" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="Mr" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="Ml" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </MidPoint>
    <!-- the five chords of the pentagram D, Mt, Mr, Mb, Ml -->
    <Segment Name="s1" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="Mr" />
    </Segment>
    <Segment Name="s2" Visible="false">
      <Dependency Name="Mr" />
      <Dependency Name="Ml" />
    </Segment>
    <Segment Name="s3" Visible="false">
      <Dependency Name="Ml" />
      <Dependency Name="Mt" />
    </Segment>
    <Segment Name="s4" Visible="false">
      <Dependency Name="Mt" />
      <Dependency Name="Mb" />
    </Segment>
    <Segment Name="s5" Visible="false">
      <Dependency Name="Mb" />
      <Dependency Name="D" />
    </Segment>
    <IntersectionPoint Name="I1" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s1" />
      <Dependency Name="s3" />
    </IntersectionPoint>
    <IntersectionPoint Name="I2" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s4" />
      <Dependency Name="s1" />
    </IntersectionPoint>
    <IntersectionPoint Name="I3" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s2" />
      <Dependency Name="s4" />
    </IntersectionPoint>
    <IntersectionPoint Name="I4" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s5" />
      <Dependency Name="s2" />
    </IntersectionPoint>
    <IntersectionPoint Name="I5" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="s3" />
      <Dependency Name="s5" />
    </IntersectionPoint>
    <Polygon Name="star" Style="Blue">
      <Dependency Name="D" />
      <Dependency Name="I1" />
      <Dependency Name="Mt" />
      <Dependency Name="I2" />
      <Dependency Name="Mr" />
      <Dependency Name="I3" />
      <Dependency Name="Mb" />
      <Dependency Name="I4" />
      <Dependency Name="Ml" />
      <Dependency Name="I5" />
    </Polygon>
    <Segment Name="DMr" Style="BlueLine">
      <Dependency Name="D" />
      <Dependency Name="Mr" />
    </Segment>
    <Segment Name="MrMl" Style="BlueLine">
      <Dependency Name="Mr" />
      <Dependency Name="Ml" />
    </Segment>
    <Segment Name="MlMt" Style="BlueLine">
      <Dependency Name="Ml" />
      <Dependency Name="Mt" />
    </Segment>
    <Segment Name="MtMb" Style="BlueLine">
      <Dependency Name="Mt" />
      <Dependency Name="Mb" />
    </Segment>
    <Segment Name="MbD" Style="BlueLine">
      <Dependency Name="Mb" />
      <Dependency Name="D" />
    </Segment>
  </Figures>
</Drawing>
