<?xml version="1.0" encoding="utf-8"?>
<!-- Geometry Snacks #1 (What Fraction is Shaded?), drawn by hand as a ruler-and-compass construction.
     A square ABCD on the hidden points A and B: perpendiculars to AB at A and B, cut by the circles of radius AB about
     them. M and N are the midpoints of the left and right sides, O the center of the square. The handle P slides along
     the top side DC; Q is where the line PO meets the bottom side, so that O is the midpoint of PQ and MPNQ is a
     parallelogram with two vertices at the midpoints of opposite sides. Its area is half the square's wherever P is;
     at either end of DC the parallelogram leans on a corner. -->
<Drawing Version="1">
  <Viewport Left="-0.6" Top="4.6" Right="4.6" Bottom="-0.6" />
  <Scene Left="-0.6" Top="4.6" Right="4.6" Bottom="-0.6" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Red" Color="#FF000000" StrokeWidth="3" Fill="#FFEF303F">
      <Dark Color="#FFE8EBF0" Fill="#FFD9333F" />
    </ShapeStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" X="0" Y="0" />
    <FreePoint Name="B" Visible="false" X="4" Y="0" />
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <PerpendicularLine Name="a" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="A" />
    </PerpendicularLine>
    <PerpendicularLine Name="b" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="B" />
    </PerpendicularLine>
    <Circle Name="ca" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <Circle Name="cb" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Circle>
    <IntersectionPoint Name="D" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="a" />
      <Dependency Name="ca" />
    </IntersectionPoint>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="b" />
      <Dependency Name="cb" />
    </IntersectionPoint>
    <Segment Name="AD" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </Segment>
    <Segment Name="BC" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </Segment>
    <Segment Name="DC" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="C" />
    </Segment>
    <MidPoint Name="M" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </MidPoint>
    <MidPoint Name="N" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="C" />
    </MidPoint>
    <MidPoint Name="O" Visible="false">
      <Dependency Name="M" />
      <Dependency Name="N" />
    </MidPoint>
    <PointOnFigure Name="P" Style="Handle" X="1" Y="4" Parameter="0.25">
      <Dependency Name="DC" />
    </PointOnFigure>
    <LineTwoPoints Name="PO" Visible="false">
      <Dependency Name="P" />
      <Dependency Name="O" />
    </LineTwoPoints>
    <IntersectionPoint Name="Q" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="PO" />
      <Dependency Name="AB" />
    </IntersectionPoint>
    <Polygon Name="ABCD" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <Polygon Name="MPNQ" Style="Red">
      <Dependency Name="M" />
      <Dependency Name="P" />
      <Dependency Name="N" />
      <Dependency Name="Q" />
    </Polygon>
  </Figures>
</Drawing>
