<?xml version="1.0" encoding="utf-8"?>
<!-- More Geometry Snacks #1 (What Fraction is Shaded?), the generalized variant of a-point-in-a-square.lgf, shown by
     the puzzle page's Generalize switch (see "Generalize" in docs/snacks.md): the statement's "square" becomes
     "parallelogram".
     The corner A is a hidden fixed point. Three handles: B, the other end of the bottom side, slides along a hidden
     stretch of the base line (from 2.5 to 5.5 units from A); D, the top-left corner, is free inside a hidden rectangle
     above the base, kept so that C stays in the scene; C is where the parallel to AD through B meets the parallel to
     AB through D, so ABCD is a parallelogram whatever the two do, and both start at the square. P is a point inside
     ABCD, free in both directions and carried along as the parallelogram changes; the triangles on the top and the
     bottom sides with their apex at P are shaded. Their area is half the parallelogram's wherever the handles are,
     since their heights add up to the distance between the two sides. The scene is wider than the book drawing's, to
     leave room. -->
<Drawing Version="1">
  <Viewport Left="-1.7" Top="5.4" Right="7.7" Bottom="-0.6" />
  <Scene Left="-1.7" Top="5.4" Right="7.7" Bottom="-0.6" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Blue" Color="#FF0000FF" StrokeWidth="3" Fill="#FFB9B9FF">
      <Dark Color="#FF9DA3FF" Fill="#FF7F86D6" />
    </ShapeStyle>
    <ShapeStyle Name="Frame" Color="#FF000000" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE8EBF0" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="0" Y="0" />
    <!-- the stretch of the base line B slides on -->
    <FreePoint Name="Bnear" Visible="false" Locked="true" X="2.5" Y="0" />
    <FreePoint Name="Bfar" Visible="false" Locked="true" X="5.5" Y="0" />
    <Segment Name="track" Visible="false">
      <Dependency Name="Bnear" />
      <Dependency Name="Bfar" />
    </Segment>
    <PointOnFigure Name="B" Style="Handle" X="4" Y="0" Parameter="0.5">
      <Dependency Name="track" />
    </PointOnFigure>
    <!-- the room D moves in -->
    <FreePoint Name="R1" Visible="false" Locked="true" X="-1.5" Y="1.2" />
    <FreePoint Name="R2" Visible="false" Locked="true" X="2" Y="1.2" />
    <FreePoint Name="R3" Visible="false" Locked="true" X="2" Y="5.2" />
    <FreePoint Name="R4" Visible="false" Locked="true" X="-1.5" Y="5.2" />
    <Polygon Name="Room" Visible="false">
      <Dependency Name="R1" />
      <Dependency Name="R2" />
      <Dependency Name="R3" />
      <Dependency Name="R4" />
    </Polygon>
    <PointInRegion Name="D" Style="Handle" X="0" Y="4">
      <Dependency Name="Room" />
    </PointInRegion>
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <LineTwoPoints Name="ad" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="D" />
    </LineTwoPoints>
    <ParallelLine Name="bc" Visible="false">
      <Dependency Name="ad" />
      <Dependency Name="B" />
    </ParallelLine>
    <ParallelLine Name="dc" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="D" />
    </ParallelLine>
    <IntersectionPoint Name="C" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="bc" />
      <Dependency Name="dc" />
    </IntersectionPoint>
    <Polygon Name="ABCD" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <PointInRegion Name="P" Style="Handle" X="2.63" Y="1.22">
      <Dependency Name="ABCD" />
    </PointInRegion>
    <Polygon Name="top" Style="Blue">
      <Dependency Name="D" />
      <Dependency Name="C" />
      <Dependency Name="P" />
    </Polygon>
    <Polygon Name="bottom" Style="Blue">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="P" />
    </Polygon>
  </Figures>
</Drawing>
