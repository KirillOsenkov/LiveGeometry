<?xml version="1.0" encoding="utf-8"?>
<!-- More Geometry Snacks #12 (What Fraction is Shaded?), drawn by hand as a ruler-and-compass construction.
     The square A B Q2 Q1 stands on the hidden points A and B (perpendiculars and circles of the side). The handle T is
     the tip above the top side: it slides on a hidden track along the perpendicular bisector of AB, from the midpoint
     M of the top side (the tip on the side, the octagon folded flat) to a side and a diagonal above it. The corner K1
     of the octagon is on the diagonal through Q1, as far from Q1 as T is (a circle about Q1 through T), so the two
     shaded triangles at Q1 are congruent; the other tips and corners are its reflections in the diagonal, the
     vertical axis and the center O, which gives the octagon its four mirror lines. The eight triangles are the shaded
     ones, each a polygon of its own; the hole between them is the square with a white triangle on each side. The
     handle starts where the triangles are equilateral, as in the book. -->
<Drawing Version="1">
  <Viewport Left="-6.4" Top="6.4" Right="6.4" Bottom="-6.4" />
  <Scene Left="-6.4" Top="6.4" Right="6.4" Bottom="-6.4" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Blue" Color="#FF0000FF" StrokeWidth="3" Fill="#FFB9B9FF">
      <Dark Color="#FF9DA3FF" Fill="#FF7F86D6" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" Locked="true" X="-1" Y="-1" />
    <FreePoint Name="B" Visible="false" Locked="true" X="1" Y="-1" />
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <PerpendicularLine Name="a" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="A" />
    </PerpendicularLine>
    <PerpendicularLine Name="b" Visible="false">
      <Dependency Name="AB" />
      <Dependency Name="B" />
    </PerpendicularLine>
    <Circle Name="ca" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Circle>
    <Circle Name="cb" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Circle>
    <IntersectionPoint Name="Q1" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="a" />
      <Dependency Name="ca" />
    </IntersectionPoint>
    <IntersectionPoint Name="Q2" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="b" />
      <Dependency Name="cb" />
    </IntersectionPoint>
    <MidPoint Name="O" Visible="false">
      <Dependency Name="Q1" />
      <Dependency Name="B" />
    </MidPoint>
    <MidPoint Name="M" Visible="false">
      <Dependency Name="Q1" />
      <Dependency Name="Q2" />
    </MidPoint>
    <SegmentBisector Name="axis" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </SegmentBisector>
    <LineTwoPoints Name="diagonal" Visible="false">
      <Dependency Name="Q1" />
      <Dependency Name="B" />
    </LineTwoPoints>
    <!-- the track: a diagonal and then a side up the axis from M -->
    <CircleByRadius Name="reach1" Visible="false">
      <Dependency Name="Q1" />
      <Dependency Name="B" />
      <Dependency Name="M" />
    </CircleByRadius>
    <IntersectionPoint Name="U1" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="axis" />
      <Dependency Name="reach1" />
    </IntersectionPoint>
    <CircleByRadius Name="reach2" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="U1" />
    </CircleByRadius>
    <IntersectionPoint Name="U2" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="axis" />
      <Dependency Name="reach2" />
    </IntersectionPoint>
    <Segment Name="track" Visible="false">
      <Dependency Name="M" />
      <Dependency Name="U2" />
    </Segment>
    <PointOnFigure Name="T" Style="Handle" X="0" Y="4.7320508076" Parameter="0.7730">
      <Dependency Name="track" />
    </PointOnFigure>
    <Circle Name="ct" Visible="false">
      <Dependency Name="Q1" />
      <Dependency Name="T" />
    </Circle>
    <IntersectionPoint Name="K1" Visible="false" Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="diagonal" />
      <Dependency Name="ct" />
    </IntersectionPoint>
    <ReflectedPoint Name="TL" Visible="false">
      <Dependency Name="T" />
      <Dependency Name="diagonal" />
    </ReflectedPoint>
    <ReflectedPoint Name="TB" Visible="false">
      <Dependency Name="T" />
      <Dependency Name="O" />
    </ReflectedPoint>
    <ReflectedPoint Name="TR" Visible="false">
      <Dependency Name="TL" />
      <Dependency Name="O" />
    </ReflectedPoint>
    <ReflectedPoint Name="K2" Visible="false">
      <Dependency Name="K1" />
      <Dependency Name="axis" />
    </ReflectedPoint>
    <ReflectedPoint Name="K3" Visible="false">
      <Dependency Name="K1" />
      <Dependency Name="O" />
    </ReflectedPoint>
    <ReflectedPoint Name="K4" Visible="false">
      <Dependency Name="K2" />
      <Dependency Name="O" />
    </ReflectedPoint>
    <Polygon Name="t1" Style="Blue">
      <Dependency Name="K1" />
      <Dependency Name="T" />
      <Dependency Name="Q1" />
    </Polygon>
    <Polygon Name="t2" Style="Blue">
      <Dependency Name="K1" />
      <Dependency Name="Q1" />
      <Dependency Name="TL" />
    </Polygon>
    <Polygon Name="t3" Style="Blue">
      <Dependency Name="K4" />
      <Dependency Name="TL" />
      <Dependency Name="A" />
    </Polygon>
    <Polygon Name="t4" Style="Blue">
      <Dependency Name="K4" />
      <Dependency Name="A" />
      <Dependency Name="TB" />
    </Polygon>
    <Polygon Name="t5" Style="Blue">
      <Dependency Name="K3" />
      <Dependency Name="TB" />
      <Dependency Name="B" />
    </Polygon>
    <Polygon Name="t6" Style="Blue">
      <Dependency Name="K3" />
      <Dependency Name="B" />
      <Dependency Name="TR" />
    </Polygon>
    <Polygon Name="t7" Style="Blue">
      <Dependency Name="K2" />
      <Dependency Name="TR" />
      <Dependency Name="Q2" />
    </Polygon>
    <Polygon Name="t8" Style="Blue">
      <Dependency Name="K2" />
      <Dependency Name="Q2" />
      <Dependency Name="T" />
    </Polygon>
  </Figures>
</Drawing>
