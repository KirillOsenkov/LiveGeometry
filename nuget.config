<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Ref12.WasmNative (builds WasmBuildNative without the wasm-tools workload) is published as GitHub Releases of Ref12/packages. -->
    <add key="Ref12" value="https://github.com/Ref12/packages/releases/download/feed/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="Ref12">
      <package pattern="Ref12.WasmNative" />
    </packageSource>
  </packageSourceMapping>
</configuration>
