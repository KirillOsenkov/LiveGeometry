<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- The app runs under the invariant culture (App.UseInvariantCulture): numbers are
         written and read with a point everywhere. Without ICU there is nothing else a
         browser's language could change, and the ICU data is not downloaded at all. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Avalonia makes a CultureInfo from a font's language id (1033) when it loads a
         glyph typeface; in invariant mode that throws CultureNotFoundException unless
         any culture name is allowed (it then just carries invariant data). -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The geometry library is consumed via reflection (Behavior.LoadBehaviors,
         serializer/figure discovery over assembly.GetTypes()), so the IL trimmer
         must keep it intact or the published app crashes at startup. -->
    <TrimmerRootAssembly Include="DynamicGeometry.Avalonia" />
    <!-- The property grid reads pages of the shared UI by reflection too (ExceptionReport):
         a property nothing referenced in code was trimmed and its row silently missing. -->
    <TrimmerRootAssembly Include="LiveGeometry" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="web.config" />
    <None Remove="web.config" />
    <None Include="web.config" />
  </ItemGroup>

  <!-- Hand-written IIS config (precompressed brotli + cache headers) replacing the SDK's
       default Wasm.web.config. It belongs at the publish root, next to wwwroot/, not
       inside it. Copied explicitly because the wasm publish pipeline drops a web.config
       Content item from the files it copies. -->
  <Target Name="CopyCustomWebConfig" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\web.config" DestinationFolder="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveGeometry\LiveGeometry.csproj" />
  </ItemGroup>

</Project>
