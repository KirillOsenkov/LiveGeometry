<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <OutputType>Exe</OutputType>
    <WasmBuildNative>true</WasmBuildNative>
    <!-- The .NET code compiled ahead of time to native wasm on publish (2026-10-07): the
         gallery's tiles load 2 to 3.5 times faster and the startup 1.3 to 1.7 times, for a
         download of 9.9 MB brotli instead of 5.3 (dotnet.native.wasm is 35 MB raw, which the
         browser also has to compile; a first visit on 4G pays about 4 s more, a returning one
         has it cached). Without AOT the browser interprets the IL. The switch: set this to
         false (or publish with -p:RunAOTCompilation=false) and the site is back on the
         interpreter; builds and `dotnet run` never compile ahead of time either way. -->
    <RunAOTCompilation>true</RunAOTCompilation>
    <!-- The app runs under the invariant culture (App.UseInvariantCulture): numbers are
         written and read with a point everywhere. Without ICU there is nothing else a
         browser's language could change, and the ICU data is not downloaded at all. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Avalonia makes a CultureInfo from a font's language id (1033) when it loads a
         glyph typeface; in invariant mode that throws CultureNotFoundException unless
         any culture name is allowed (it then just carries invariant data). -->
    <PredefinedCulturesOnly>false</PredefinedCulturesOnly>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- the emoji font: the SDK compresses .otf but not .ttf, and brotli takes it from
         1.5 MB to 0.6 MB (web.config serves the .br); the gallery drawings served as files -->
    <CompressionIncludePatterns>**/*.ttf;**/*.lgf</CompressionIncludePatterns>
  </PropertyGroup>

  <!-- the JavaScript player, concatenated from Main/Player/src before the build -->
  <Import Project="..\..\Player\Player.targets" />

  <ItemGroup>
    <!-- The geometry library is consumed via reflection (Behavior.LoadBehaviors,
         serializer/figure discovery over assembly.GetTypes()), so the IL trimmer
         must keep it intact or the published app crashes at startup. -->
    <TrimmerRootAssembly Include="LiveGeometry" />
    <!-- The property grid reads pages of the shared UI by reflection too (ExceptionReport):
         a property nothing referenced in code was trimmed and its row silently missing. -->
    <TrimmerRootAssembly Include="LiveGeometry.App" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="web.config" />
    <None Remove="web.config" />
    <None Include="web.config" />
  </ItemGroup>

  <!-- Hand-written IIS config (precompressed brotli + cache headers) replacing the SDK's
       default Wasm.web.config. It belongs at the publish root, next to wwwroot/, not
       inside it. Copied explicitly because the wasm publish pipeline drops a web.config
       Content item from the files it copies. -->
  <Target Name="CopyCustomWebConfig" AfterTargets="Publish">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\web.config" DestinationFolder="$(PublishDir)" />
  </Target>

  <ItemGroup>
    <!-- the emoji font, fetched on first use (EmojiFont), not part of the startup download -->
    <Content Include="..\Fonts\Twemoji.Mozilla.ttf" Link="wwwroot\fonts\Twemoji.Mozilla.ttf" />
    <!-- the history page, a static site of its own at /history (web.config routes it) -->
    <Content Include="..\..\..\history\**" Link="wwwroot\history\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- the player, for pages anywhere that embed a drawing (PlayerEmbed): a version
         folder, so that a snippet pasted into a post keeps playing when the format moves on -->
    <Content Include="$(PlayerOutput)" Link="wwwroot\player\$(PlayerVersion)\player.js" />
    <!-- the gallery drawings as files, for an embed by URL (data-src): /gallery/<file>.lgf;
         a path with an extension is a file and never falls through to the app's /gallery/<slug> -->
    <Content Include="..\LiveGeometry.App\Gallery\Drawings\*.lgf" Link="wwwroot\gallery\%(Filename)%(Extension)" />
    <!-- the catalog as the embed page's picker reads it (WriteGalleryIndex below) -->
    <Content Include="$(GalleryIndexOutput)" Link="wwwroot\gallery\index.json" />
    <!-- every page of the site for search engines (WriteGalleryIndex below; robots.txt names it) -->
    <Content Include="$(SitemapOutput)" Link="wwwroot\sitemap.xml" />
    <!-- the embed page, a static site of its own at /embed (web.config routes it), like /history -->
    <Content Include="..\..\..\embed\**" Link="wwwroot\embed\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- the gallery and its drawings played by the player, no .NET: /web and /web/<slug>
         (web.config routes every extensionless path under /web to the page) -->
    <Content Include="..\..\..\web\**" Link="wwwroot\web\%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Catriona Agg's puzzles, played by the player: /CatrionaAgg and /CatrionaAgg/<slug>
         (web.config routes them; each puzzle's own page is written by WriteGalleryIndex below) -->
    <Content Include="..\..\..\CatrionaAgg\**" Link="wwwroot\CatrionaAgg\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <GalleryCatalogSource>$(MSBuildProjectDirectory)\..\LiveGeometry.App\Gallery\GalleryCatalog.cs</GalleryCatalogSource>
    <GalleryIndexOutput>$(MSBuildProjectDirectory)\obj\gallery\index.json</GalleryIndexOutput>
    <GalleryPagesOutput>$(MSBuildProjectDirectory)\obj\gallery\pages</GalleryPagesOutput>
    <SitemapOutput>$(MSBuildProjectDirectory)\obj\gallery\sitemap.xml</SitemapOutput>
    <CatrionaFolder>$(MSBuildProjectDirectory)\..\..\..\CatrionaAgg</CatrionaFolder>
    <CatrionaPagesOutput>$(MSBuildProjectDirectory)\obj\catriona\pages</CatrionaPagesOutput>
    <WebTemplate>$(MSBuildProjectDirectory)\..\..\..\web\index.html</WebTemplate>
    <WebPagesOutput>$(MSBuildProjectDirectory)\obj\web\pages</WebPagesOutput>
    <!-- where the site is, for the absolute addresses link previews and the sitemap need -->
    <SiteUrl Condition="'$(SiteUrl)' == ''">https://livegeometry.com</SiteUrl>
  </PropertyGroup>

  <ItemGroup>
    <GalleryIndexInput Include="$(MSBuildProjectFullPath);$(GalleryCatalogSource);wwwroot\index.html;$(WebTemplate);..\LiveGeometry.App\Gallery\Drawings\*.lgf;$(CatrionaFolder)\puzzle.html;$(CatrionaFolder)\puzzles.json" />
  </ItemGroup>

  <!-- /gallery/index.json: the slugs, titles and files of the catalog in its order, read
       off GalleryCatalog.cs (its Item("slug", "Title"[, "File"][, stackedFigureShare: n])
       lines), so that the embed page and the /web page list the gallery as the app does
       without a copy of the list to keep in step.
       /gallery/<slug>.html: the app's index.html for each drawing, with the drawing's title,
       the start of its explanation and its preview picture (/gallery/previews/<File>.png,
       made after the publish by tools/previews.cs) in the head and on the splash. Sites that
       show a link's preview read only the page's HTML, never what its script draws, and
       every /gallery/<slug> was the same page (web.config serves these in its place).
       /web/<slug>.html: the same for the gallery without .NET, web/index.html with the
       drawing's tags (web.config serves it for /web/<slug> when it is there).
       /sitemap.xml: the site's pages, the drawings among them.
       /CatrionaAgg/<slug>.html: the same for each of Catriona Agg's puzzles that has a drawing
       (CatrionaAgg/puzzles.json): the library's puzzle.html with the puzzle's title, its question
       and its preview picture (/CatrionaAgg/previews/<slug>.png) in the head, and its title and
       question in the page's panel. -->
  <UsingTask TaskName="WriteGalleryIndex" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Source ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <Template ParameterType="System.String" Required="true" />
      <DrawingsFolder ParameterType="System.String" Required="true" />
      <PagesFolder ParameterType="System.String" Required="true" />
      <SitemapFile ParameterType="System.String" Required="true" />
      <SiteUrl ParameterType="System.String" Required="true" />
      <CatrionaFolder ParameterType="System.String" Required="true" />
      <CatrionaPagesFolder ParameterType="System.String" Required="true" />
      <WebTemplate ParameterType="System.String" Required="true" />
      <WebPagesFolder ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Text.RegularExpressions" />
      <Using Namespace="System.Xml.Linq" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        // The first whole sentences of the drawing's explanation that say no live value ([AB]
        // is worked out as the drawing is played), paragraph by paragraph until there are a
        // hundred characters or so. A paragraph that ends in a colon ends it, with a period: what
        // comes after it (a list, a formula) is no description.
        string Describe(string path)
        {
            var labels = XDocument.Load(path).Descendants("Label").ToList();
            var label = labels.FirstOrDefault(l => (string)l.Attribute("Name") == "Description")
                ?? labels.FirstOrDefault(l => (string)l.Attribute("Style") == "Explanation");
            string text = (string)label?.Attribute("Text");
            if (text == null)
            {
                return null;
            }

            // a line break in a label's text is the two characters \n, a backslash two backslashes
            var unescaped = new StringBuilder();
            for (int i = 0; i < text.Length; i++)
            {
                if (text[i] == '\\' && i + 1 < text.Length)
                {
                    i++;
                    unescaped.Append(text[i] == 'n' ? '\n' : text[i]);
                }
                else
                {
                    unescaped.Append(text[i]);
                }
            }

            var said = new StringBuilder();
            foreach (string paragraph in unescaped.ToString().Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
            {
                var part = new StringBuilder();
                bool cutShort = false;
                bool done = false;
                foreach (string sentence in Regex.Split(Regex.Replace(paragraph, "\\s+", " ").Trim(), "(?<=[.!?][\"')]?)\\s+"))
                {
                    string whole = sentence.EndsWith(":") ? sentence.Substring(0, sentence.Length - 1) + "." : sentence;
                    if (whole.Contains("[") || !Regex.IsMatch(whole, "[.!?][\"')]?$"))
                    {
                        cutShort = true;
                        break;
                    }

                    if (said.Length + part.Length + whole.Length > 300 && said.Length + part.Length > 0)
                    {
                        done = true;
                        break;
                    }

                    part.Append(part.Length > 0 ? " " : "").Append(whole);
                    if (whole != sentence)
                    {
                        done = true;
                        break;
                    }
                }

                // a sentence or two before a live value may not stand on their own ("C is their product.")
                if (part.Length > 0 && !(cutShort && part.Length < 40))
                {
                    said.Append(said.Length > 0 ? " " : "").Append(part);
                }

                if (done || said.Length >= 100)
                {
                    break;
                }
            }

            return said.Length > 0 ? said.ToString() : null;
        }

        string Escape(string text) => text.Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;").Replace("\"", "&quot;");

        // index.html changed so that a pattern no longer finds its one place: say so, rather
        // than give the drawings pages without their own tags
        string ReplaceOnce(string text, string pattern, Func<Match, string> replacement, string template = null)
        {
            var regex = new Regex(pattern, RegexOptions.Singleline);
            if (regex.Matches(text).Count != 1)
            {
                throw new InvalidOperationException((template ?? Template) + " no longer has exactly one match of " + pattern + ": update the WriteGalleryIndex task in LiveGeometry.Browser.csproj.");
            }

            return regex.Replace(text, match => replacement(match), 1);
        }

        // a question as the catalog has it, with the wiki's TeX ($6$, $x^2$, $\sqrt{2}$), as
        // plainQuestion in CatrionaAgg/catriona.js writes it (the dollar in brackets: MSBuild
        // takes a dollar and a parenthesis for a property, here too)
        string PlainQuestion(string text) => Regex.Replace(text ?? "", "[$]([^$]*)[$]", m =>
        {
            string tex = m.Groups[1].Value;
            tex = Regex.Replace(tex, "\\\\frac\\{([^}]*)\\}\\{([^}]*)\\}", "$1/$2");
            tex = Regex.Replace(tex, "\\\\sqrt\\{([^}]*)\\}", "√$1");
            tex = tex.Replace("\\pi", "π").Replace("\\times", "×").Replace("\\circ", "°");
            tex = Regex.Replace(tex, "\\^\\{?2\\}?", "²");
            tex = Regex.Replace(tex, "\\^\\{?3\\}?", "³");
            return Regex.Replace(tex, "[{}\\\\]", "");
        });

        string template = File.ReadAllText(Template);
        string webTemplate = File.ReadAllText(WebTemplate);
        foreach (string folder in new[] { PagesFolder, WebPagesFolder })
        {
            Directory.CreateDirectory(folder);
            foreach (string stale in Directory.GetFiles(folder, "*.html"))
            {
                File.Delete(stale);
            }
        }

        var sitemap = new StringBuilder("<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n");
        foreach (string page in new[] { "/", "/history", "/history/tabula", "/embed" })
        {
            sitemap.Append("  <url><loc>").Append(SiteUrl).Append(page).Append("</loc></url>\n");
        }

        var items = new StringBuilder();
        foreach (Match match in Regex.Matches(File.ReadAllText(Source), "Item\\(\"([^\"]+)\",\\s*\"([^\"]+)\"(?:,\\s*\"([^\"]+)\")?(?:,\\s*stackedFigureShare:\\s*([0-9.]+))?"))
        {
            string slug = match.Groups[1].Value;
            string title = match.Groups[2].Value;
            string file = match.Groups[3].Success
                ? match.Groups[3].Value
                : string.Concat(slug.Split('-').Select(word => char.ToUpperInvariant(word[0]) + word.Substring(1)));
            string url = SiteUrl + "/gallery/" + slug;
            string description = Escape(Describe(Path.Combine(DrawingsFolder, file + ".lgf")) ?? title + ": an interactive geometry drawing with figures you can drag around.");
            string escapedTitle = Escape(title);
            string html = template;
            try
            {
                html = ReplaceOnce(html, "<title>[^<]*</title>", m => "<title>" + escapedTitle + " · Live Geometry</title>");
                html = ReplaceOnce(html, "<meta name=\"description\" content=\"[^\"]*\">", m => "<meta name=\"description\" content=\"" + description + "\">");
                html = ReplaceOnce(html, "<meta property=\"og:title\" content=\"[^\"]*\">", m => "<meta property=\"og:title\" content=\"" + escapedTitle + "\">");
                html = ReplaceOnce(html, "<meta property=\"og:description\" content=\"[^\"]*\">", m => "<meta property=\"og:description\" content=\"" + description + "\">");
                html = ReplaceOnce(html, "<meta property=\"og:url\" content=\"[^\"]*\">", m => "<meta property=\"og:url\" content=\"" + url + "\">");
                // the homepage's picture gives way to the drawing's own (the rest of the tags, og:type to twitter:card, are the homepage's)
                html = ReplaceOnce(html, "<meta property=\"og:image\" content=\"[^\"]*\">", m => "<meta property=\"og:image\" content=\"" + SiteUrl + "/gallery/previews/" + file + ".png\">");
                html = ReplaceOnce(html, "<link rel=\"canonical\" href=\"[^\"]*\">", m => "<link rel=\"canonical\" href=\"" + url + "\">");
                // the splash says what the drawing is while the app loads, and is the text a search engine indexes
                html = ReplaceOnce(html, "<h1>[^<]*</h1>(\\s*)<p>.*?</p>", m => "<h1>" + escapedTitle + "</h1>" + m.Groups[1].Value + "<p>" + description + "</p>");

                // the same drawing at /web/<slug>: the page's tags say which drawing, with its picture
                string webUrl = SiteUrl + "/web/" + slug;
                string webHtml = webTemplate;
                webHtml = ReplaceOnce(webHtml, "<title>[^<]*</title>", m => "<title>" + escapedTitle + " · Live Geometry</title>", WebTemplate);
                webHtml = ReplaceOnce(webHtml, "<meta name=\"description\" content=\"[^\"]*\">", m => "<meta name=\"description\" content=\"" + description + "\">", WebTemplate);
                webHtml = ReplaceOnce(webHtml, "<meta property=\"og:title\" content=\"[^\"]*\">", m => "<meta property=\"og:title\" content=\"" + escapedTitle + "\">", WebTemplate);
                webHtml = ReplaceOnce(webHtml, "<meta property=\"og:description\" content=\"[^\"]*\">", m => "<meta property=\"og:description\" content=\"" + description + "\">", WebTemplate);
                webHtml = ReplaceOnce(webHtml, "<meta property=\"og:url\" content=\"[^\"]*\">", m => "<meta property=\"og:url\" content=\"" + webUrl + "\">", WebTemplate);
                webHtml = ReplaceOnce(webHtml, "<meta property=\"og:image\" content=\"[^\"]*\">", m => "<meta property=\"og:image\" content=\"" + SiteUrl + "/gallery/previews/" + file + ".png\">", WebTemplate);
                webHtml = ReplaceOnce(webHtml, "<link rel=\"canonical\" href=\"[^\"]*\">", m => "<link rel=\"canonical\" href=\"" + webUrl + "\">", WebTemplate);
                File.WriteAllText(Path.Combine(WebPagesFolder, slug + ".html"), webHtml, new UTF8Encoding(false));
            }
            catch (InvalidOperationException ex)
            {
                Log.LogError(ex.Message);
                return false;
            }

            File.WriteAllText(Path.Combine(PagesFolder, slug + ".html"), html, new UTF8Encoding(false));
            sitemap.Append("  <url><loc>").Append(url).Append("</loc></url>\n");
            items.Append(items.Length == 0 ? "[\n" : ",\n");
            items.Append("  {\"slug\": \"").Append(slug).Append("\", \"title\": \"").Append(title.Replace("\\", "\\\\").Replace("\"", "\\\"")).Append("\", \"file\": \"").Append(file).Append(".lgf\"");
            if (match.Groups[4].Success)
            {
                items.Append(", \"stackedFigureShare\": ").Append(match.Groups[4].Value);
            }

            items.Append("}");
        }

        items.Append("\n]\n");
        Directory.CreateDirectory(Path.GetDirectoryName(OutputFile));
        File.WriteAllText(OutputFile, items.ToString(), new UTF8Encoding(false));

        // Catriona Agg's puzzles: a page for each one that has a drawing
        string catrionaTemplatePath = Path.Combine(CatrionaFolder, "puzzle.html");
        string catrionaTemplate = File.ReadAllText(catrionaTemplatePath);
        Directory.CreateDirectory(CatrionaPagesFolder);
        foreach (string stale in Directory.GetFiles(CatrionaPagesFolder, "*.html"))
        {
            File.Delete(stale);
        }

        sitemap.Append("  <url><loc>").Append(SiteUrl).Append("/CatrionaAgg</loc></url>\n");
        // the catalog is tools/catriona.cs's JSON: an object per puzzle with nothing nested in
        // braces, its strings with JSON's escapes (an inline task has no JSON library to hand)
        string catalogText = File.ReadAllText(Path.Combine(CatrionaFolder, "puzzles.json"));
        Func<string, string, string> field = (entry, name) =>
        {
            var found = Regex.Match(entry, "\"" + name + "\":\\s*\"((?:[^\"\\\\]|\\\\.)*)\"");
            return found.Success ? Regex.Unescape(found.Groups[1].Value) : null;
        };
        {
            // an entry is an object of strings and arrays; a string may hold braces (a question's \frac{1}{3})
            const string Item = "(?:[^{}\"]|\"(?:[^\"\\\\]|\\\\.)*\")*";
            foreach (Match entry in Regex.Matches(catalogText, "\\{" + Item + "\"slug\"" + Item + "\\}"))
            {
                if (field(entry.Value, "drawing") == null)
                {
                    continue;
                }

                string slug = field(entry.Value, "slug");
                string title = field(entry.Value, "title");
                // a puzzle with no page of its own on Mathforge has no question written down (as catriona.js says it)
                string statement = field(entry.Value, "statement");
                string question = statement != null ? "“" + PlainQuestion(statement) + "”" : "This puzzle didn’t have a description.";
                string url = SiteUrl + "/CatrionaAgg/" + slug;
                string escapedTitle = Escape(title);
                string description = Escape(statement != null
                    ? "Catriona Agg's puzzle: " + question + " With links to Andrew Stacey's techniques and solutions at Mathforge Notes."
                    : "Catriona Agg's puzzle, redrawn as live geometry you can drag.");
                string html = catrionaTemplate;
                try
                {
                    html = ReplaceOnce(html, "<title>[^<]*</title>", m => "<title>" + escapedTitle + " · Catriona Agg · Live Geometry</title>", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<meta name=\"description\" content=\"[^\"]*\">", m => "<meta name=\"description\" content=\"" + description + "\">", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<meta property=\"og:title\" content=\"[^\"]*\">", m => "<meta property=\"og:title\" content=\"" + escapedTitle + " · Catriona Agg\">", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<meta property=\"og:description\" content=\"[^\"]*\">", m => "<meta property=\"og:description\" content=\"" + description + "\">", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<meta property=\"og:url\" content=\"[^\"]*\">", m => "<meta property=\"og:url\" content=\"" + url + "\">", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<meta property=\"og:type\" content=\"[^\"]*\">", m => "<meta property=\"og:type\" content=\"article\">", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<meta property=\"og:image\" content=\"[^\"]*\">", m => "<meta property=\"og:image\" content=\"" + SiteUrl + "/CatrionaAgg/previews/" + slug + ".png\">", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<link rel=\"canonical\" href=\"[^\"]*\">", m => "<link rel=\"canonical\" href=\"" + url + "\">", catrionaTemplatePath);
                    // the drawing on its way with the scripts, as the catalog is
                    html = ReplaceOnce(html, "<link rel=\"preload\" href=\"/CatrionaAgg/puzzles.json\"[^>]*>", m => m.Value + "\n<link rel=\"preload\" href=\"/CatrionaAgg/drawings/" + Escape(field(entry.Value, "drawing")) + "\" as=\"fetch\" crossorigin>", catrionaTemplatePath);
                    // the title and the question are on the page before the script fills in the rest
                    html = ReplaceOnce(html, "<h1 id=\"p-title\"></h1>", m => "<h1 id=\"p-title\">" + escapedTitle + "</h1>", catrionaTemplatePath);
                    html = ReplaceOnce(html, "<p id=\"p-question\"></p>", m => "<p id=\"p-question\">" + Escape(question) + "</p>", catrionaTemplatePath);
                }
                catch (InvalidOperationException ex)
                {
                    Log.LogError(ex.Message);
                    return false;
                }

                File.WriteAllText(Path.Combine(CatrionaPagesFolder, slug + ".html"), html, new UTF8Encoding(false));
                sitemap.Append("  <url><loc>").Append(url).Append("</loc></url>\n");
            }
        }

        sitemap.Append("</urlset>\n");
        File.WriteAllText(SitemapFile, sitemap.ToString(), new UTF8Encoding(false));
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="WriteGalleryIndex" BeforeTargets="BeforeBuild;AssignTargetPaths" Inputs="@(GalleryIndexInput)" Outputs="$(GalleryIndexOutput);$(SitemapOutput)">
    <WriteGalleryIndex
      Source="$(GalleryCatalogSource)"
      OutputFile="$(GalleryIndexOutput)"
      Template="$(MSBuildProjectDirectory)\wwwroot\index.html"
      DrawingsFolder="$(MSBuildProjectDirectory)\..\LiveGeometry.App\Gallery\Drawings"
      PagesFolder="$(GalleryPagesOutput)"
      SitemapFile="$(SitemapOutput)"
      SiteUrl="$(SiteUrl)"
      CatrionaFolder="$(CatrionaFolder)"
      CatrionaPagesFolder="$(CatrionaPagesOutput)"
      WebTemplate="$(WebTemplate)"
      WebPagesFolder="$(WebPagesOutput)" />
  </Target>

  <!-- the pages are known only once they are written, so they are taken in here and not with
       the other files above: as /gallery/<slug>.html beside the drawings' files, and as
       /web/<slug>.html beside the /web page -->
  <Target Name="IncludeGalleryPages" DependsOnTargets="WriteGalleryIndex" BeforeTargets="BeforeBuild;AssignTargetPaths">
    <ItemGroup>
      <GalleryPage Include="$(GalleryPagesOutput)\*.html" />
      <Content Include="@(GalleryPage)" Link="wwwroot\gallery\%(GalleryPage.Filename)%(GalleryPage.Extension)" />
      <WebPage Include="$(WebPagesOutput)\*.html" />
      <Content Include="@(WebPage)" Link="wwwroot\web\%(WebPage.Filename)%(WebPage.Extension)" />
      <CatrionaPage Include="$(CatrionaPagesOutput)\*.html" />
      <Content Include="@(CatrionaPage)" Link="wwwroot\CatrionaAgg\%(CatrionaPage.Filename)%(CatrionaPage.Extension)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveGeometry.App\LiveGeometry.App.csproj" />
  </ItemGroup>

</Project>
