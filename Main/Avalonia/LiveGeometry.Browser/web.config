<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS / Azure App Service configuration for the published static site. Replaces the
     web.config the WebAssembly SDK would otherwise generate (it keeps that file's MIME
     maps and the wwwroot/SPA rewrites) and adds two things the default lacks:
     1. Precompressed brotli - publish emits a .br sibling for every asset; when the
        client advertises br support, rewrite the request to the .br file and repair
        Content-Encoding plus the per-type Content-Type on the way out. The default
        only gets IIS on-the-fly gzip, which is nearly twice the size on the wire.
     2. Cache-Control - see the outbound rules. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".webcil" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".ttf" />
      <remove fileExtension=".br" />
      <remove fileExtension=".lgf" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <!-- the gallery drawings as files (/gallery/<file>.lgf), for the player's data-src -->
      <mimeMap fileExtension=".lgf" mimeType="application/xml" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".webcil" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff" />
      <mimeMap fileExtension=".ttf" mimeType="font/ttf" />
      <!-- Deliberately a type that is not listed under httpCompression, so IIS never
           gzips the already-compressed bytes; the outbound rules restore the real type. -->
      <mimeMap fileExtension=".br" mimeType="application/x-brotli" />
    </staticContent>
    <!-- Fallback for the rare client without brotli support: IIS on-the-fly gzip. -->
    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
      </dynamicTypes>
    </httpCompression>
    <rewrite>
      <rules>
        <rule name="Serve precompressed brotli" stopProcessing="true">
          <match url="^(.*\.(wasm|dat|js|css|json|html|ico|ttf|lgf))$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\{R:1}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/{R:1}.br" />
        </rule>
        <!-- A static page of its own beside the app. Without this, /history is a folder,
             not a file, and the SPA fallback below would answer with the app instead. -->
        <rule name="History page" stopProcessing="true">
          <match url="^history/?$" />
          <action type="Rewrite" url="wwwroot/history/index.html" />
        </rule>
        <!-- The Tabula wing of the history: a page beside index.html, its pictures in the
             folder of the same name, so /history/tabula must be the page and not the folder. -->
        <rule name="Tabula page" stopProcessing="true">
          <match url="^history/tabula/?$" />
          <action type="Rewrite" url="wwwroot/history/tabula.html" />
        </rule>
        <rule name="Embed page" stopProcessing="true">
          <match url="^embed/?$" />
          <action type="Rewrite" url="wwwroot/embed/index.html" />
        </rule>
        <!-- The gallery without .NET: /web is the gallery, /web/<slug> a drawing, both the
             one page (it reads the address). A path with an extension is a file of the folder. -->
        <rule name="Web page" stopProcessing="true">
          <match url="^web(/[^.]*)?$" />
          <action type="Rewrite" url="wwwroot/web/index.html" />
        </rule>
        <!-- A drawing of the gallery: the app's page with the drawing's own title, explanation
             and preview picture in its head (the WriteGalleryIndex task in the csproj writes
             one per drawing), for link previews and search engines; brotli when the client
             takes it. A slug without a page is the app's own index.html, as before. -->
        <rule name="Gallery drawing page, brotli" stopProcessing="true">
          <match url="^gallery/([a-z0-9-]+)/?$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\gallery\{R:1}.html.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/gallery/{R:1}.html.br" />
        </rule>
        <rule name="Gallery drawing page" stopProcessing="true">
          <match url="^gallery/([a-z0-9-]+)/?$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}wwwroot\gallery\{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/gallery/{R:1}.html" />
        </rule>
        <!-- Catriona Agg's puzzles: /CatrionaAgg is the gallery (index.html), /CatrionaAgg/<slug>
             the page the WriteGalleryIndex task writes for the puzzle (its title and preview in
             the head), else the puzzle page it is written from (puzzle.html), which says what it
             doesn't have. A path with an extension is a file of the folder (puzzles.json,
             drawings/, previews/). -->
        <rule name="Catriona Agg puzzle page, brotli" stopProcessing="true">
          <match url="^CatrionaAgg/([a-z0-9-]+)/?$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\CatrionaAgg\{R:1}.html.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/CatrionaAgg/{R:1}.html.br" />
        </rule>
        <rule name="Catriona Agg puzzle page" stopProcessing="true">
          <match url="^CatrionaAgg/([a-z0-9-]+)/?$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}wwwroot\CatrionaAgg\{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/CatrionaAgg/{R:1}.html" />
        </rule>
        <rule name="Catriona Agg missing puzzle, brotli" stopProcessing="true">
          <match url="^CatrionaAgg/[^.]+$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\CatrionaAgg\puzzle.html.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/CatrionaAgg/puzzle.html.br" />
        </rule>
        <rule name="Catriona Agg missing puzzle" stopProcessing="true">
          <match url="^CatrionaAgg/[^.]+$" />
          <action type="Rewrite" url="wwwroot/CatrionaAgg/puzzle.html" />
        </rule>
        <rule name="Catriona Agg gallery, brotli" stopProcessing="true">
          <match url="^CatrionaAgg/?$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\CatrionaAgg\index.html.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/CatrionaAgg/index.html.br" />
        </rule>
        <rule name="Catriona Agg gallery" stopProcessing="true">
          <match url="^CatrionaAgg/?$" />
          <action type="Rewrite" url="wwwroot/CatrionaAgg/index.html" />
        </rule>
        <!-- Shared drawings (Export > Copy share link): /s/<id> is the page that plays one
             (the /web page), /s/<id>.lgf the drawing, a redirect to where it is stored. Links
             and embeds name only these, never the storage, so the storage can move: change
             the redirect. Temporary (302, and no-cache below) for that reason, so that no
             browser keeps the old place. -->
        <rule name="Shared drawing file" stopProcessing="true">
          <match url="^s/([a-z2-7]{8,})\.lgf$" />
          <action type="Redirect" url="https://livegeometry.blob.core.windows.net/shared-drawings/{R:1}.lgf" redirectType="Found" />
        </rule>
        <rule name="Shared drawing page" stopProcessing="true">
          <match url="^s/[a-z2-7]{8,}/?$" />
          <action type="Rewrite" url="wwwroot/web/index.html" />
        </rule>
        <rule name="Serve subdir">
          <match url=".*" />
          <action type="Rewrite" url="wwwroot\{R:0}" />
        </rule>
        <rule name="SPA fallback routing" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="wwwroot\" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Caching: almost every asset is content-fingerprinted (the 10-char hash in
             the file name), so it can be cached forever; a later deployment changes the
             name, never the content. The few stable-named entry files (index.html,
             main.js, app.css, favicon.ico, and the loader scripts the SDK does not
             fingerprint) must revalidate so deployments propagate. The emoji font under
             fonts/ is cached forever although its name has no hash: a new font needs a new
             file name. The player (player/<version>/player.js) and the gallery's .lgf files
             revalidate too: a snippet on another site pins the version folder, and fixes
             within the version must reach it. So do the drawings' preview pictures
             (gallery/previews/ and CatrionaAgg/previews/, made again at every deployment under
             the same names), the Catriona Agg library's script, styles and icons (CatrionaAgg/*.js,
             *.css, *.svg, which every puzzle's page links by name), the sitemap, robots.txt
             and the logo (logo.svg, logo-512.png: directories elsewhere link to them by
             name; the Catriona Agg pages show it too).
             The default rule
             runs first and the mutable-set rule second, overwriting the header, and the
             stale-while-revalidate rule last: the player, the logo and the Catriona Agg
             library's files (its script, styles, icons, catalog and drawings) are used from
             the cache for a day while they are revalidated in the background, so that a step
             from one puzzle's page to the next (every page links them all by name) renders
             without a round trip for each; a deployment reaches a returning reader one page
             load late, an embed on another site one load late too. -->
        <rule name="cache immutable by default">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="cache revalidate mutable entry files" preCondition="mutable-entry-file">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <rule name="cache stale while revalidating" preCondition="stale-while-revalidate-file">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="max-age=0, stale-while-revalidate=86400" />
        </rule>
        <!-- {URL} in outbound pre-conditions is the rewritten URL, so these fire only
             when the brotli sibling was actually served. -->
        <rule name="br content encoding" preCondition="served-br">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <rule name="br vary" preCondition="served-br">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <rule name="br wasm content type" preCondition="served-br-wasm">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>
        <rule name="br dat content type" preCondition="served-br-dat">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/octet-stream" />
        </rule>
        <rule name="br js content type" preCondition="served-br-js">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/javascript" />
        </rule>
        <rule name="br css content type" preCondition="served-br-css">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/css" />
        </rule>
        <rule name="br json content type" preCondition="served-br-json">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/json" />
        </rule>
        <rule name="br html content type" preCondition="served-br-html">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/html" />
        </rule>
        <rule name="br ico content type" preCondition="served-br-ico">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="image/x-icon" />
        </rule>
        <rule name="br ttf content type" preCondition="served-br-ttf">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="font/ttf" />
        </rule>
        <rule name="br lgf content type" preCondition="served-br-lgf">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/xml" />
        </rule>
        <!-- The player and the drawings are for pages on other sites: a script tag needs
             nothing, but the fetch of an .lgf by the player (data-src) is blocked by the
             browser unless the file's server allows it (CORS). A shared drawing's redirect
             needs it as much as the stored file (the storage's own CORS rule) does. -->
        <rule name="shared with other sites" preCondition="shared-file">
          <match serverVariable="RESPONSE_Access_Control_Allow_Origin" pattern=".*" />
          <action type="Rewrite" value="*" />
        </rule>
        <preConditions>
          <preCondition name="shared-file">
            <add input="{URL}" pattern="/player/.*\.js(\.br)?$|/gallery/[^/]+\.lgf(\.br)?$|/CatrionaAgg/drawings/[^/]+\.lgf(\.br)?$|/s/[^/]+\.lgf$" />
          </preCondition>
          <preCondition name="mutable-entry-file">
            <add input="{URL}" pattern="(/|\.html(\.br)?|/main\.js(\.br)?|/app\.css(\.br)?|/favicon\.ico(\.br)?|\.json(\.br)?|\.map|\.lgf(\.br)?|\.xml|\.txt)$|/_framework/(dotnet|avalonia|storage|sw)\.js(\.map)?(\.br)?$|/player/[^/]+/player\.js(\.br)?$|/gallery/previews/[^/]+\.png$|/CatrionaAgg/previews/[^/]+\.png$|/CatrionaAgg/[^/]+\.(css|js|svg)(\.br)?$|/logo(-512)?\.(svg|png)$" />
          </preCondition>
          <preCondition name="stale-while-revalidate-file">
            <add input="{URL}" pattern="/player/[^/]+/player\.js(\.br)?$|/CatrionaAgg/[^/]+\.(css|js|svg|json)(\.br)?$|/CatrionaAgg/drawings/[^/]+\.lgf(\.br)?$|/logo\.svg$" />
          </preCondition>
          <preCondition name="served-br">
            <add input="{URL}" pattern="\.br$" />
          </preCondition>
          <preCondition name="served-br-wasm">
            <add input="{URL}" pattern="\.wasm\.br$" />
          </preCondition>
          <preCondition name="served-br-dat">
            <add input="{URL}" pattern="\.dat\.br$" />
          </preCondition>
          <preCondition name="served-br-js">
            <add input="{URL}" pattern="\.js\.br$" />
          </preCondition>
          <preCondition name="served-br-css">
            <add input="{URL}" pattern="\.css\.br$" />
          </preCondition>
          <preCondition name="served-br-json">
            <add input="{URL}" pattern="\.json\.br$" />
          </preCondition>
          <preCondition name="served-br-html">
            <add input="{URL}" pattern="\.html\.br$" />
          </preCondition>
          <preCondition name="served-br-ico">
            <add input="{URL}" pattern="\.ico\.br$" />
          </preCondition>
          <preCondition name="served-br-ttf">
            <add input="{URL}" pattern="\.ttf\.br$" />
          </preCondition>
          <preCondition name="served-br-lgf">
            <add input="{URL}" pattern="\.lgf\.br$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
