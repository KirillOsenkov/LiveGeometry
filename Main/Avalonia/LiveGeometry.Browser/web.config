<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS / Azure App Service configuration for the published static site. Replaces the
     web.config the WebAssembly SDK would otherwise generate (it keeps that file's MIME
     maps and the wwwroot/SPA rewrites) and adds two things the default lacks:
     1. Precompressed brotli - publish emits a .br sibling for every asset; when the
        client advertises br support, rewrite the request to the .br file and repair
        Content-Encoding plus the per-type Content-Type on the way out. The default
        only gets IIS on-the-fly gzip, which is nearly twice the size on the wire.
     2. Cache-Control - see the outbound rules. -->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".blat" />
      <remove fileExtension=".dat" />
      <remove fileExtension=".dll" />
      <remove fileExtension=".webcil" />
      <remove fileExtension=".json" />
      <remove fileExtension=".wasm" />
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".br" />
      <mimeMap fileExtension=".blat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dll" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".webcil" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".dat" mimeType="application/octet-stream" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <mimeMap fileExtension=".woff" mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="application/font-woff" />
      <!-- Deliberately a type that is not listed under httpCompression, so IIS never
           gzips the already-compressed bytes; the outbound rules restore the real type. -->
      <mimeMap fileExtension=".br" mimeType="application/x-brotli" />
    </staticContent>
    <!-- Fallback for the rare client without brotli support: IIS on-the-fly gzip. -->
    <httpCompression>
      <dynamicTypes>
        <add mimeType="application/octet-stream" enabled="true" />
        <add mimeType="application/wasm" enabled="true" />
      </dynamicTypes>
    </httpCompression>
    <rewrite>
      <rules>
        <rule name="Serve precompressed brotli" stopProcessing="true">
          <match url="^(.*\.(wasm|dat|js|css|json|html|ico))$" />
          <conditions>
            <add input="{HTTP_ACCEPT_ENCODING}" pattern="\bbr\b" />
            <add input="{APPL_PHYSICAL_PATH}wwwroot\{R:1}.br" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="wwwroot/{R:1}.br" />
        </rule>
        <rule name="Serve subdir">
          <match url=".*" />
          <action type="Rewrite" url="wwwroot\{R:0}" />
        </rule>
        <rule name="SPA fallback routing" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="wwwroot\" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Caching: almost every asset is content-fingerprinted (the 10-char hash in
             the file name), so it can be cached forever; a later deployment changes the
             name, never the content. The few stable-named entry files (index.html,
             main.js, app.css, favicon.ico, and the loader scripts the SDK does not
             fingerprint) must revalidate so deployments propagate. The default rule
             runs first and the mutable-set rule second, overwriting the header. -->
        <rule name="cache immutable by default">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=31536000, immutable" />
        </rule>
        <rule name="cache revalidate mutable entry files" preCondition="mutable-entry-file">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache" />
        </rule>
        <!-- {URL} in outbound pre-conditions is the rewritten URL, so these fire only
             when the brotli sibling was actually served. -->
        <rule name="br content encoding" preCondition="served-br">
          <match serverVariable="RESPONSE_Content_Encoding" pattern=".*" />
          <action type="Rewrite" value="br" />
        </rule>
        <rule name="br vary" preCondition="served-br">
          <match serverVariable="RESPONSE_Vary" pattern=".*" />
          <action type="Rewrite" value="Accept-Encoding" />
        </rule>
        <rule name="br wasm content type" preCondition="served-br-wasm">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/wasm" />
        </rule>
        <rule name="br dat content type" preCondition="served-br-dat">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/octet-stream" />
        </rule>
        <rule name="br js content type" preCondition="served-br-js">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/javascript" />
        </rule>
        <rule name="br css content type" preCondition="served-br-css">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/css" />
        </rule>
        <rule name="br json content type" preCondition="served-br-json">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="application/json" />
        </rule>
        <rule name="br html content type" preCondition="served-br-html">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="text/html" />
        </rule>
        <rule name="br ico content type" preCondition="served-br-ico">
          <match serverVariable="RESPONSE_Content_Type" pattern=".*" />
          <action type="Rewrite" value="image/x-icon" />
        </rule>
        <preConditions>
          <preCondition name="mutable-entry-file">
            <add input="{URL}" pattern="(/|\.html(\.br)?|/main\.js(\.br)?|/app\.css(\.br)?|/favicon\.ico(\.br)?|\.json(\.br)?|\.map)$|/_framework/(dotnet|avalonia|storage|sw)\.js(\.map)?(\.br)?$" />
          </preCondition>
          <preCondition name="served-br">
            <add input="{URL}" pattern="\.br$" />
          </preCondition>
          <preCondition name="served-br-wasm">
            <add input="{URL}" pattern="\.wasm\.br$" />
          </preCondition>
          <preCondition name="served-br-dat">
            <add input="{URL}" pattern="\.dat\.br$" />
          </preCondition>
          <preCondition name="served-br-js">
            <add input="{URL}" pattern="\.js\.br$" />
          </preCondition>
          <preCondition name="served-br-css">
            <add input="{URL}" pattern="\.css\.br$" />
          </preCondition>
          <preCondition name="served-br-json">
            <add input="{URL}" pattern="\.json\.br$" />
          </preCondition>
          <preCondition name="served-br-html">
            <add input="{URL}" pattern="\.html\.br$" />
          </preCondition>
          <preCondition name="served-br-ico">
            <add input="{URL}" pattern="\.ico\.br$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
  </system.webServer>
</configuration>
