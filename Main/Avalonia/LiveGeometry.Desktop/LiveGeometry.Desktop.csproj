<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ApplicationIcon>..\LiveGeometry\Assets\DG.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiveGeometry\LiveGeometry.csproj" />
  </ItemGroup>

  <!-- the JavaScript player, concatenated from Main/Player/src before the build -->
  <Import Project="..\..\Player\Player.targets" />

  <ItemGroup>
    <!-- the emoji font, read on first use (EmojiFont) -->
    <None Include="..\Fonts\Twemoji.Mozilla.ttf" Link="Fonts\Twemoji.Mozilla.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- the player, read by Save as .html (PlayerEmbed), which writes it into the page -->
    <None Include="$(PlayerOutput)" Link="player\player.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
