<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1" Creator="LiveGeometry.App">
  <Viewport Left="-2" Top="3.5" Right="6.5" Bottom="-2.5" Grid="true" Axes="true" />
  <Styles>
    <PointStyle Name="7" Fill="#FFC0C0C0" Color="#FF000000" StrokeWidth="0.7">
      <Dark Color="#FFD1D1D1" />
    </PointStyle>
    <PointStyle Name="8" Fill="#FFC0C0C0" Color="#FF000000" StrokeWidth="0.7">
      <Dark Color="#FFD1D1D1" />
    </PointStyle>
    <PointStyle Name="9" Size="8" Fill="#FFC0C0C0" Color="#FF0000FF" StrokeWidth="0.7" />
    <LineStyle Name="10" Color="#FF000000">
      <Dark Color="#FFD1D1D1" />
    </LineStyle>
    <LineStyle Name="11" Color="#FF0000FF" />
  </Styles>
  <Figures>
    <FreePoint Name="O" Style="7" X="0" Y="0" />
    <FreePoint Name="A" Style="8" X="1.839999" Y="1.370612" />
    <FreePoint Name="B" Style="8" X="1.5" Y="0.6" />
    <PointByCoordinates Name="C" Style="9" X="A.X * B.X - A.Y * B.Y" Y="A.Y * B.X + A.X * B.Y">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </PointByCoordinates>
    <FreePoint Name="X" Visible="false" Style="7" X="6" Y="0" />
    <Segment Name="AO" Style="10">
      <Dependency Name="O" />
      <Dependency Name="A" />
    </Segment>
    <Segment Name="BO" Style="10">
      <Dependency Name="O" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="CO" Style="11">
      <Dependency Name="O" />
      <Dependency Name="C" />
    </Segment>
    <Vector Name="OA" Style="10">
      <Dependency Name="O" />
      <Dependency Name="A" />
    </Vector>
    <Vector Name="OB" Style="10">
      <Dependency Name="O" />
      <Dependency Name="B" />
    </Vector>
    <Vector Name="OC" Style="10">
      <Dependency Name="O" />
      <Dependency Name="C" />
    </Vector>
    <Label Name="Title" Style="GalleryTitle" Text="Complex Multiplication" Pin="TopRight" OffsetX="16" OffsetY="25.5" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Think of the arrows as complex numbers: A = [A.X] + [A.Y]i and B = [B.X] + [B.Y]i.\n\nC is their product. Its angle, counted counterclockwise from the x-axis, is the sum of the two angles ([deg(xang(O, A))]° + [deg(xang(O, B))]° = [deg(xang(O, C))]°; past 360° it starts over at 0°), and its length is the product of the two lengths ([AO] · [OB] = [OC]).\n\nMultiplying by a complex number rotates and stretches. Drag A and B." Pin="TopRight" OffsetX="16" OffsetY="73.5" WrapWidth="400" Backdrop="true">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="O" />
      <Dependency Name="C" />
    </Label>
  </Figures>
</Drawing>