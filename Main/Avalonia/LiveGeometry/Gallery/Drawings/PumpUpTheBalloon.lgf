      <Dependency Name="Skin8" />
      <Dependency Name="Skin9" />
      <Dependency Name="Skin10" />
      <Dependency Name="Skin11" />
      <Dependency Name="NeckTopLeft" />
      <Dependency Name="NeckBottomLeft" />
      <Dependency Name="Hint" />
    </ShowHideControl>
    <Label Name="Title" Style="GalleryTitle" Text="Pump Up the Balloon" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Pull the red pump handle up to let the air out: the balloon flops over in a crumpled heap. Now push it down: the rubber lifts, stands up and stretches smooth, round and shiny. Keep an eye on the gauge! Drag the balloon anywhere and the hose follows.\n\nThe outline is one closed curve through 15 dots: check &quot;Hint&quot; to watch them spread apart. What happens if you push the handle all the way down?" Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true" />
  </Figures>
