    </PointByCoordinates>
    <PointByCoordinates Name="Body" Visible="false" X="Air.Y * (1 - 0.58 * Limp.X) * (1 + 0.07 * Firm.Y)" Y="Air.Y * (1 + 0 * Limp.X - 0.05 * Firm.X)">
      <Dependency Name="Air" />
