    <Label Name="Title" Style="GalleryTitle" Text="Desargues' Theorem" DecimalsToShow="2" Pin="TopRight" OffsetX="16" OffsetY="57.5" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Two triangles are &quot;in perspective from a point&quot; when the lines through matching vertices all meet in one point - like a shape and its shadow.\n\nThen the matching sides, extended, meet in three points that always lie on one line.\n\nDrag the vertices. Drawing by Chris Burrows." DecimalsToShow="2" Pin="TopRight" OffsetX="16" OffsetY="105.5" WrapWidth="400" Backdrop="true" />
