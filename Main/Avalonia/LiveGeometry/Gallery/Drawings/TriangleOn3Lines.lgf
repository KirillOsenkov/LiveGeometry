    <Label Name="Title" Style="GalleryTitle" Text="Triangle on Three Lines" Pin="TopRight" OffsetX="16" OffsetY="89.5" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Here are three parallel lines. Can you construct an equilateral triangle with one vertex on each line?\n\nDrag the yellow point: the triangle follows. Think about how it is done, then check &quot;Show solution&quot;." Pin="TopRight" OffsetX="16" OffsetY="137.5" WrapWidth="400" Backdrop="true" />
