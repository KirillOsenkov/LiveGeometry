    <PointByCoordinates Name="Seed92" Style="Blue heart" X="0.132681 * sqrt(92) * cos(92 * Turn.X)" Y="0.132681 * sqrt(92) * sin(92 * Turn.X)">
      <Dependency Name="Turn" />
    </PointByCoordinates>
    <PointByCoordinates Name="Seed93" Style="White heart" X="0.132681 * sqrt(93) * cos(93 * Turn.X)" Y="0.132681 * sqrt(93) * sin(93 * Turn.X)">
