    <Label Name="Title" Style="GalleryTitle" Text="Golden Angle" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Each heart sits a little farther out than the one before, and turned [deg(Turn.X)]° further around.\n\nDrag the bee to change the turn. Most turns line the hearts up in spokes or curly arms, with gaps in between. One special turn fills the circle with no gaps at all. Can you find it? Stuck? Check &quot;Hint&quot;.\n\nSunflowers know that turn: their seeds grow the same way." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true">
      <Dependency Name="Turn" />
    </Label>
  </Figures>
