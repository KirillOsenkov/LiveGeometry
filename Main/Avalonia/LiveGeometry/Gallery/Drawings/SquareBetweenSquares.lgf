    <Label Name="Title" Style="GalleryTitle" Text="Square Between Squares" Pin="TopRight" OffsetX="16" OffsetY="36.25" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Take any two squares (pink and green) and connect their matching corners with four gray segments.\n\nPick a point on one segment, and the points the same fraction of the way along the other three. They form another square (yellow)!\n\nSlide the green point from the pink square to the green one. Drag the yellow points to move and turn the squares." Pin="TopRight" OffsetX="16" OffsetY="84.25" WrapWidth="400" Backdrop="true" />
