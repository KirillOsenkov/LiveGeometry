<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1" Creator="LiveGeometry.App">
  <Viewport Left="-4.2" Top="4.6" Right="4.2" Bottom="-4.6" Grid="true" Axes="true" />
  <Styles>
    <PointStyle Name="Amplitude" Size="14" Fill="#FFFFEF00" Color="#FFA05C21" StrokeWidth="2" />
    <PointStyle Name="Frequency" Size="14" Fill="#FF7CE38B" Color="#FF2E7D32" StrokeWidth="2">
      <Dark Color="#FF8AD48E" />
    </PointStyle>
    <LineStyle Name="Wave" Color="#FFF6A372" StrokeWidth="4" />
    <LineStyle Name="Track" Color="#FFB8B8B8" StrokeWidth="3" />
    <LineStyle Name="Guide" Color="#FF8A8A8A" StrokeWidth="1.25" Dash="Dash" />
    <TextStyle Name="Measure" FontSize="16" Color="#FF5A5A5A" FontFamily="Segoe UI" />
  </Styles>
  <Figures>
    <FreePoint Name="T1" Visible="false" X="0" Y="-3" />
    <FreePoint Name="T2" Visible="false" X="4" Y="-3" />
    <Segment Name="Track" Style="Track">
      <Dependency Name="T1" />
      <Dependency Name="T2" />
    </Segment>
    <PointOnFigure Name="F" Style="Frequency" X="1" Y="-3" Parameter="0.25">
      <Dependency Name="Track" />
    </PointOnFigure>
    <DistanceMeasurement Name="FrequencyValue" Style="Measure" OffsetX="-14" OffsetY="10">
      <Dependency Name="T1" />
      <Dependency Name="F" />
    </DistanceMeasurement>
    <PointByCoordinates Name="P1" Visible="false" X="pi / (2 * F.X + 0.0002)" Y="0">
      <Dependency Name="F" />
    </PointByCoordinates>
    <PointByCoordinates Name="P2" Visible="false" X="pi / (2 * F.X + 0.0002)" Y="1">
      <Dependency Name="F" />
    </PointByCoordinates>
    <LineTwoPoints Name="Post" Visible="false" Style="Guide">
      <Dependency Name="P1" />
      <Dependency Name="P2" />
    </LineTwoPoints>
    <PointOnFigure Name="A" Style="Amplitude" X="1.5706392628686097" Y="1" Parameter="1">
      <Dependency Name="Post" />
    </PointOnFigure>
    <Segment Name="Guide" Style="Guide">
      <Dependency Name="P1" />
      <Dependency Name="A" />
    </Segment>
    <PointByCoordinates Name="Q1" Visible="false" X="pi / (2 * F.X + 0.0002)" Y="A.Y / 2">
      <Dependency Name="F" />
      <Dependency Name="A" />
    </PointByCoordinates>
    <PointByCoordinates Name="Q2" Visible="false" X="pi / (2 * F.X + 0.0002)" Y="1.5 * A.Y">
      <Dependency Name="F" />
      <Dependency Name="A" />
    </PointByCoordinates>
    <DistanceMeasurement Name="AmplitudeValue" Style="Measure" OffsetX="12" OffsetY="-26">
      <Dependency Name="Q1" />
      <Dependency Name="Q2" />
    </DistanceMeasurement>
    <FunctionGraph Name="Wave" Style="Wave" Function="A.Y * sin(F.X * x)">
      <Dependency Name="A" />
      <Dependency Name="F" />
    </FunctionGraph>
    <Label Name="Title" Style="GalleryTitle" Text="Sine Wave" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="y = [A.Y] · sin([F.X] · x)\n\nThe yellow point rides on the crest of the wave. Drag it up and down to change the number in front of the sine, the amplitude: how tall the wave is. What happens when it is negative? When it is zero?\n\nThe green point on the track at the bottom changes the number next to x: the bigger it is, the more tightly the waves are packed and the shorter the period, the distance from one crest to the next.\n\nThe number beside each slider is the one in the equation." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true">
      <Dependency Name="A" />
      <Dependency Name="F" />
    </Label>
  </Figures>
</Drawing>