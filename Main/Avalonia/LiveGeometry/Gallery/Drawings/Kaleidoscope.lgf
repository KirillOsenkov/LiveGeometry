    <Label Name="Title" Style="GalleryTitle" Text="Kaleidoscope" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Only the bright slice is real. The rest are its reflections, as in the mirrors of a kaleidoscope, so every emoji has eleven twins.\n\nDrag the emoji in the bright slice and watch the twins dance. Push one onto a mirror line and its twins pair up.\n\nTo swap an emoji, click it, choose Edit this style and pick another one: all twelve change together." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true" />
  </Figures>
