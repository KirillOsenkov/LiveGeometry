<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1" Creator="LiveGeometry.App">
  <Viewport Left="-5.6" Top="3.8" Right="5.6" Bottom="-3.8" Grid="true" Axes="true" />
  <Styles>
    <PointStyle Name="Runner" Size="14" Fill="#FFFFEF00" Color="#FFA05C21" StrokeWidth="2" />
    <PointStyle Name="Handle" Size="12" Fill="#FF7CE38B" Color="#FF2E7D32" StrokeWidth="2" />
    <PointStyle Name="OnEllipse" Size="9" Fill="#FF7A62D9" Color="#FF4A3A99" StrokeWidth="1.5" />
    <PointStyle Name="Center" Size="9" Fill="#FF3FA34D" Color="#FF256B30" StrokeWidth="1.5" />
    <LineStyle Name="Ellipse" Color="#FF7A62D9" StrokeWidth="2.5" />
    <LineStyle Name="Evolute" Color="#FF3FA34D" StrokeWidth="2.5" />
    <LineStyle Name="Radius" Color="#FF6E6E6E" StrokeWidth="1.25" Dash="Dot" />
    <LineStyle Name="Hidden" Color="#FF000000" />
    <ShapeStyle Name="Dial" Fill="#00FFFFFF" Color="#FFB8B8B8" StrokeWidth="3" />
    <ShapeStyle Name="Osculating" Fill="#00FFFFFF" Color="#FF6E6E6E" StrokeWidth="1.5" Dash="Dash" />
    <TextStyle Name="Name" FontSize="17" Color="#FF2B3038" FontFamily="Segoe UI" />
  </Styles>
  <Figures>
    <FreePoint Name="P0" Visible="false" X="-4.4" Y="2.7" />
    <PointByCoordinates Name="P1" Visible="false" X="P0.X + 0.75" Y="P0.Y">
      <Dependency Name="P0" />
    </PointByCoordinates>
    <Circle Name="Dial" Style="Dial">
      <Dependency Name="P0" />
      <Dependency Name="P1" />
    </Circle>
    <PointOnFigure Name="T" Style="Runner" X="-3.7809982888177416" Y="3.123481855046277" Parameter="0.6">
      <Dependency Name="Dial" />
    </PointOnFigure>
    <FreePoint Name="O" Visible="false" X="0" Y="0" />
    <FreePoint Name="X1" Visible="false" X="1" Y="0" />
    <FreePoint Name="Y1" Visible="false" X="0" Y="1" />
    <LineTwoPoints Name="XAxis" Visible="false" Style="Hidden">
      <Dependency Name="O" />
      <Dependency Name="X1" />
    </LineTwoPoints>
    <LineTwoPoints Name="YAxis" Visible="false" Style="Hidden">
      <Dependency Name="O" />
      <Dependency Name="Y1" />
    </LineTwoPoints>
    <PointOnFigure Name="a" Style="Handle" X="4" Y="0" Parameter="4">
      <Dependency Name="XAxis" />
    </PointOnFigure>
    <PointOnFigure Name="b" Style="Handle" X="0" Y="3" Parameter="3">
      <Dependency Name="YAxis" />
    </PointOnFigure>
    <PointByCoordinates Name="L" Style="OnEllipse" X="a.X * (T.X - P0.X) / 0.75" Y="b.Y * (T.Y - P0.Y) / 0.75">
      <Dependency Name="a" />
      <Dependency Name="b" />
      <Dependency Name="T" />
      <Dependency Name="P0" />
    </PointByCoordinates>
    <PointByCoordinates Name="M" Style="Center" X="(a.X ^ 2 - b.Y ^ 2) / a.X * ((T.X - P0.X) / 0.75) ^ 3" Y="(b.Y ^ 2 - a.X ^ 2) / b.Y * ((T.Y - P0.Y) / 0.75) ^ 3">
      <Dependency Name="a" />
      <Dependency Name="b" />
      <Dependency Name="T" />
      <Dependency Name="P0" />
    </PointByCoordinates>
    <Locus Name="EllipseLocus" Style="Ellipse">
      <Dependency Name="L" />
      <Dependency Name="T" />
    </Locus>
    <Locus Name="EvoluteLocus" Style="Evolute">
      <Dependency Name="M" />
      <Dependency Name="T" />
    </Locus>
    <Circle Name="Osculating" Style="Osculating">
      <Dependency Name="M" />
      <Dependency Name="L" />
    </Circle>
    <Segment Name="Radius" Style="Radius">
      <Dependency Name="M" />
      <Dependency Name="L" />
    </Segment>
    <PointLabel Name="aName" Style="Name" OffsetX="8" OffsetY="4" ShowName="true" ShowCoordinates="false">
      <Dependency Name="a" />
    </PointLabel>
    <PointLabel Name="bName" Style="Name" OffsetX="10" OffsetY="-22" ShowName="true" ShowCoordinates="false">
      <Dependency Name="b" />
    </PointLabel>
    <PointLabel Name="LName" Style="Name" OffsetX="8" OffsetY="-24" ShowName="true" ShowCoordinates="false">
      <Dependency Name="L" />
    </PointLabel>
    <PointLabel Name="MName" Style="Name" OffsetX="8" OffsetY="4" ShowName="true" ShowCoordinates="false">
      <Dependency Name="M" />
    </PointLabel>
    <Label Name="Title" Style="GalleryTitle" Text="Ellipse and Its Evolute" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="The yellow point runs around the little circle, and its angle — from 0 to 2π — drives point L around the ellipse: L = (a · cos θ, b · sin θ).\n\nAt every position there is a circle that hugs the ellipse best, drawn dashed, and M is its center. As L travels, M traces the four-pointed star: the evolute of the ellipse. Make the ellipse long and thin and the star pokes out through it.\n\nDrag the yellow point around its circle. Drag the green points a and b, the half-width and the half-height of the ellipse, to reshape it." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true" />
  </Figures>
</Drawing>