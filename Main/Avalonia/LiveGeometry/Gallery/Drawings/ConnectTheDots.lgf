    <ShapeStyle Name="Band" IsFilled="false" Color="#80303A5A" StrokeWidth="1.5" Dash="Dash" />
    <PointStyle Name="Dot" Size="14" Fill="#FF26215C" Color="#FFFFFFFF" StrokeWidth="2" />
    <PointStyle Name="HoleDot" Shape="Diamond" Size="13" Fill="#FF26215C" Color="#FFFFFFFF" StrokeWidth="2" />
