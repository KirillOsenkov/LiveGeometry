    <FreePoint Name="C" X="-5.4791666666" Y="-6.1979166664" />
    <FreePoint Name="D" X="-3.375" Y="-2.0937499998" />
    <Ray Name="CD" Style="RedLine">
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Ray>
    <Segment Name="AC" Style="RedLine">
      <Dependency Name="A" />
      <Dependency Name="C" />
