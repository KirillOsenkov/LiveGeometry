    <Label Name="Title" Style="GalleryTitle" Text="Square in a Square" Pin="TopRight" OffsetX="16" OffsetY="57.5" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="In square ABCD mark points E, F, G and H at the same distance from the corners: AE = BF = CG = DH.\n\nEFGH is a square too, and the four corner triangles are congruent right triangles. This picture is the heart of a famous proof of the Pythagorean theorem.\n\nDrag E along the side." Pin="TopRight" OffsetX="16" OffsetY="105.5" WrapWidth="400" Backdrop="true" />
