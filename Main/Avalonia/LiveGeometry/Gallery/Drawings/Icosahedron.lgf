    <Label Name="Title" Style="GalleryTitle" Text="Icosahedron" DecimalsToShow="2" Pin="TopRight" OffsetX="16" OffsetY="78.75" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Twenty triangles, twelve corners, thirty edges: the icosahedron is the biggest of the five Platonic solids. A 20-sided die has this shape.\n\nThis is a flat drawing of it, so dragging a corner squashes the solid instead of turning it - try it." DecimalsToShow="2" Pin="TopRight" OffsetX="16" OffsetY="126.75" WrapWidth="400" Backdrop="true" />
