    <Label Name="Label1" Style="10" DecimalsToShow="2" Text="Steiner's problem" X="-10.046318208471" Y="6.31441961529606" />
    <Label Name="Label2" Style="11" DecimalsToShow="2" Text="In an arbitrary quadrilateral ABCD,\nfind such point E that the sum of\ndistances from E to vertices would\nbe minimal." X="-10.047059033986" Y="5.45351753912945" />
    <Label Name="Label3" Style="12" DecimalsToShow="2" Text="|EA|+|EB|+|EC|+|ED| = [dist(E,A)+dist(E,B)+dist(E,C)+dist(E,D)]" X="1.940006198769" Y="-2.89401526781011">
