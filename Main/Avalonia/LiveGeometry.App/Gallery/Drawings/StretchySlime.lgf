    <MidPoint Name="Middle" Visible="false">
      <Dependency Name="FistL" />
      <Dependency Name="FistR" />
    </MidPoint>
    <PointByCoordinates Name="Frame" Visible="false" X="atan2(FistR.Y - FistL.Y, FistR.X - FistL.X)" Y="clamp(dist(FistL, FistR), 0.4, 7)">
      <Dependency Name="FistR" />
      <Dependency Name="FistL" />
    </PointByCoordinates>
    <PointByCoordinates Name="Axis" Visible="false" X="cos(Frame.X)" Y="sin(Frame.X)">
      <Dependency Name="Frame" />
    </PointByCoordinates>
    <PointByCoordinates Name="Rope" Visible="false" X="Frame.Y / 2 - 0.15 * min(1, Frame.Y / 2.5)" Y="clamp(1.05 / (1 + ((Frame.Y / 2 - 0.15 * min(1, Frame.Y / 2.5)) / 1.4)^2), 0.22, 1)">
      <Dependency Name="Frame" />
    </PointByCoordinates>
    <PointByCoordinates Name="Body" Visible="false" X="(sqrt((2 * Rope.X * (0.466667 + 0.533333 * Rope.Y))^2 + 12.566371) - (2 * Rope.X * (0.466667 + 0.533333 * Rope.Y))) / pi" Y="Rope.X + (sqrt((2 * Rope.X * (0.466667 + 0.533333 * Rope.Y))^2 + 12.566371) - (2 * Rope.X * (0.466667 + 0.533333 * Rope.Y))) / pi">
      <Dependency Name="Rope" />
    </PointByCoordinates>
    <PointByCoordinates Name="Sag" Visible="false" X="min(0.9, 0.055 * Frame.Y^2) * abs(Axis.X)" Y="(3 - 2 * clamp((abs(Axis.X) - 0.88) / 0.105, 0, 1)) * clamp((abs(Axis.X) - 0.88) / 0.105, 0, 1)^2">
      <Dependency Name="Frame" />
      <Dependency Name="Axis" />
