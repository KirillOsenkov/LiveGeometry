      <Dependency Name="LeftCenter" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r1ny" Formula="(r1hy - L.Y) / R">
      <Dependency Name="r1hy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r1ci" Formula="-(dx * r1nx + dy * r1ny)">
      <Dependency Name="dx" />
      <Dependency Name="r1nx" />
      <Dependency Name="dy" />
      <Dependency Name="r1ny" />
