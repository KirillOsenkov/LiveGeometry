    </Number>
    <Number Name="r14ex" Formula="0.666667 * dx + (0.666667 * r14ci - r14sq) * r14nx">
      <Dependency Name="dx" />
      <Dependency Name="r14ci" />
      <Dependency Name="r14sq" />
      <Dependency Name="r14nx" />
    </Number>
    <Number Name="r14ey" Formula="0.666667 * dy + (0.666667 * r14ci - r14sq) * r14ny">
      <Dependency Name="dy" />
      <Dependency Name="r14ci" />
      <Dependency Name="r14sq" />
      <Dependency Name="r14ny" />
    </Number>
    <Number Name="r14b2" Formula="(r14hx - RightCenter.X) * r14ex + (r14hy - L.Y) * r14ey">
      <Dependency Name="r14hx" />
      <Dependency Name="RightCenter" />
      <Dependency Name="r14ex" />
      <Dependency Name="r14hy" />
      <Dependency Name="L" />
      <Dependency Name="r14ey" />
    </Number>
    <Number Name="r14t2" Formula="-r14b2 + sqrt(max(r14b2^2 - (r14hx - RightCenter.X)^2 - (r14hy - L.Y)^2 + R^2, 0))">
      <Dependency Name="r14b2" />
      <Dependency Name="r14hx" />
      <Dependency Name="RightCenter" />
      <Dependency Name="r14hy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r14gx" Formula="r14hx + r14t2 * r14ex">
      <Dependency Name="r14hx" />
      <Dependency Name="r14t2" />
      <Dependency Name="r14ex" />
    </Number>
    <Number Name="r14gy" Formula="r14hy + r14t2 * r14ey">
      <Dependency Name="r14hy" />
      <Dependency Name="r14t2" />
      <Dependency Name="r14ey" />
    </Number>
    <Number Name="r14mx" Formula="(r14gx - RightCenter.X) / R">
      <Dependency Name="r14gx" />
      <Dependency Name="RightCenter" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r14my" Formula="(r14gy - L.Y) / R">
      <Dependency Name="r14gy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r14co" Formula="r14ex * r14mx + r14ey * r14my">
      <Dependency Name="r14ex" />
      <Dependency Name="r14mx" />
      <Dependency Name="r14ey" />
      <Dependency Name="r14my" />
    </Number>
    <Number Name="r14k" Formula="1 - 2.25 * (1 - r14co^2)">
      <Dependency Name="r14co" />
    </Number>
    <Number Name="r14fx" Formula="1.5 * r14ex - (1.5 * r14co - sqrt(r14k)) * r14mx">
      <Dependency Name="r14ex" />
      <Dependency Name="r14co" />
      <Dependency Name="r14k" />
      <Dependency Name="r14mx" />
    </Number>
    <Number Name="r14fy" Formula="1.5 * r14ey - (1.5 * r14co - sqrt(r14k)) * r14my">
      <Dependency Name="r14ey" />
      <Dependency Name="r14co" />
      <Dependency Name="r14k" />
      <Dependency Name="r14my" />
    </Number>
    <PointByCoordinates Name="r14O" Visible="false" X="r14ox" Y="r14oy">
      <Dependency Name="r14ox" />
      <Dependency Name="r14oy" />
    </PointByCoordinates>
    <PointByCoordinates Name="r14In" Visible="false" X="if(r14hit, r14hx, r14ox + dx)" Y="if(r14hit, r14hy, r14oy + dy)">
      <Dependency Name="r14hit" />
      <Dependency Name="r14hx" />
      <Dependency Name="r14ox" />
      <Dependency Name="dx" />
      <Dependency Name="r14hy" />
      <Dependency Name="r14oy" />
      <Dependency Name="dy" />
    </PointByCoordinates>
    <PointByCoordinates Name="r14Out" Visible="false" X="if(r14hit, r14gx, r14ox + dx)" Y="if(r14hit, r14gy, r14oy + dy)">
      <Dependency Name="r14hit" />
      <Dependency Name="r14gx" />
      <Dependency Name="r14ox" />
      <Dependency Name="dx" />
      <Dependency Name="r14gy" />
      <Dependency Name="r14oy" />
      <Dependency Name="dy" />
    </PointByCoordinates>
    <PointByCoordinates Name="r14On" Visible="false" X="if(r14hit, r14gx + r14fx, r14ox + 2 * dx)" Y="if(r14hit, r14gy + r14fy, r14oy + 2 * dy)">
      <Dependency Name="r14hit" />
      <Dependency Name="r14gx" />
      <Dependency Name="r14fx" />
      <Dependency Name="r14ox" />
      <Dependency Name="dx" />
      <Dependency Name="r14gy" />
      <Dependency Name="r14fy" />
      <Dependency Name="r14oy" />
      <Dependency Name="dy" />
    </PointByCoordinates>
    <Segment Name="r14SunGlow" Style="SunbeamGlow">
      <Dependency Name="r14O" />
      <Dependency Name="r14In" />
    </Segment>
    <Segment Name="r14Sun" Style="Sunbeam">
      <Dependency Name="r14O" />
      <Dependency Name="r14In" />
    </Segment>
    <Segment Name="r14GlassGlow" Style="SunbeamGlow">
      <Dependency Name="r14In" />
      <Dependency Name="r14Out" />
    </Segment>
    <Segment Name="r14Glass" Style="Sunbeam">
      <Dependency Name="r14In" />
      <Dependency Name="r14Out" />
    </Segment>
    <Ray Name="r14HotGlow" Style="WarmGlow">
      <Dependency Name="r14Out" />
      <Dependency Name="r14On" />
    </Ray>
    <Ray Name="r14Hot" Style="Warm">
      <Dependency Name="r14Out" />
      <Dependency Name="r14On" />
    </Ray>
    <Number Name="r14heat" Formula="if(r14hit * (r14k &gt; 0), (abs((Wick.X - r14gx) * r14fy - (Wick.Y - r14gy) * r14fx) &lt; 0.25) * ((Wick.X - r14gx) * r14fx + (Wick.Y - r14gy) * r14fy &gt; 0), 0)">
      <Dependency Name="r14hit" />
      <Dependency Name="r14k" />
      <Dependency Name="Wick" />
      <Dependency Name="r14gx" />
      <Dependency Name="r14fy" />
      <Dependency Name="r14gy" />
      <Dependency Name="r14fx" />
    </Number>
    <Number Name="r15ox" Formula="Sun.X - dy * 2.1">
      <Dependency Name="Sun" />
      <Dependency Name="dy" />
    </Number>
    <Number Name="r15oy" Formula="Sun.Y + dx * 2.1">
      <Dependency Name="Sun" />
      <Dependency Name="dx" />
    </Number>
    <Number Name="r15b" Formula="(r15ox - LeftCenter.X) * dx + (r15oy - L.Y) * dy">
      <Dependency Name="r15ox" />
      <Dependency Name="LeftCenter" />
      <Dependency Name="dx" />
      <Dependency Name="r15oy" />
      <Dependency Name="L" />
      <Dependency Name="dy" />
    </Number>
    <Number Name="r15disc" Formula="r15b^2 - (r15ox - LeftCenter.X)^2 - (r15oy - L.Y)^2 + R^2">
      <Dependency Name="r15b" />
      <Dependency Name="r15ox" />
      <Dependency Name="LeftCenter" />
      <Dependency Name="r15oy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r15t" Formula="-r15b - sqrt(max(r15disc, 0))">
      <Dependency Name="r15b" />
      <Dependency Name="r15disc" />
    </Number>
    <Number Name="r15hx" Formula="r15ox + r15t * dx">
      <Dependency Name="r15ox" />
      <Dependency Name="r15t" />
      <Dependency Name="dx" />
    </Number>
    <Number Name="r15hy" Formula="r15oy + r15t * dy">
      <Dependency Name="r15oy" />
      <Dependency Name="r15t" />
      <Dependency Name="dy" />
    </Number>
    <Number Name="r15hit" Formula="(r15disc &gt; 0) * (abs(r15hy - L.Y) &lt; 2.4)">
      <Dependency Name="r15disc" />
      <Dependency Name="r15hy" />
      <Dependency Name="L" />
    </Number>
    <Number Name="r15nx" Formula="(r15hx - LeftCenter.X) / R">
      <Dependency Name="r15hx" />
      <Dependency Name="LeftCenter" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r15ny" Formula="(r15hy - L.Y) / R">
      <Dependency Name="r15hy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r15ci" Formula="-(dx * r15nx + dy * r15ny)">
      <Dependency Name="dx" />
      <Dependency Name="r15nx" />
      <Dependency Name="dy" />
      <Dependency Name="r15ny" />
    </Number>
    <Number Name="r15sq" Formula="sqrt(1 - 0.666667^2 * (1 - r15ci^2))">
      <Dependency Name="r15ci" />
    </Number>
    <Number Name="r15ex" Formula="0.666667 * dx + (0.666667 * r15ci - r15sq) * r15nx">
      <Dependency Name="dx" />
      <Dependency Name="r15ci" />
      <Dependency Name="r15sq" />
      <Dependency Name="r15nx" />
    </Number>
    <Number Name="r15ey" Formula="0.666667 * dy + (0.666667 * r15ci - r15sq) * r15ny">
      <Dependency Name="dy" />
      <Dependency Name="r15ci" />
      <Dependency Name="r15sq" />
      <Dependency Name="r15ny" />
    </Number>
    <Number Name="r15b2" Formula="(r15hx - RightCenter.X) * r15ex + (r15hy - L.Y) * r15ey">
      <Dependency Name="r15hx" />
      <Dependency Name="RightCenter" />
      <Dependency Name="r15ex" />
      <Dependency Name="r15hy" />
      <Dependency Name="L" />
      <Dependency Name="r15ey" />
    </Number>
    <Number Name="r15t2" Formula="-r15b2 + sqrt(max(r15b2^2 - (r15hx - RightCenter.X)^2 - (r15hy - L.Y)^2 + R^2, 0))">
      <Dependency Name="r15b2" />
      <Dependency Name="r15hx" />
      <Dependency Name="RightCenter" />
      <Dependency Name="r15hy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r15gx" Formula="r15hx + r15t2 * r15ex">
      <Dependency Name="r15hx" />
      <Dependency Name="r15t2" />
      <Dependency Name="r15ex" />
    </Number>
    <Number Name="r15gy" Formula="r15hy + r15t2 * r15ey">
      <Dependency Name="r15hy" />
      <Dependency Name="r15t2" />
      <Dependency Name="r15ey" />
    </Number>
    <Number Name="r15mx" Formula="(r15gx - RightCenter.X) / R">
      <Dependency Name="r15gx" />
      <Dependency Name="RightCenter" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r15my" Formula="(r15gy - L.Y) / R">
      <Dependency Name="r15gy" />
      <Dependency Name="L" />
      <Dependency Name="R" />
    </Number>
    <Number Name="r15co" Formula="r15ex * r15mx + r15ey * r15my">
      <Dependency Name="r15ex" />
      <Dependency Name="r15mx" />
      <Dependency Name="r15ey" />
      <Dependency Name="r15my" />
    </Number>
    <Number Name="r15k" Formula="1 - 2.25 * (1 - r15co^2)">
      <Dependency Name="r15co" />
    </Number>
    <Number Name="r15fx" Formula="1.5 * r15ex - (1.5 * r15co - sqrt(r15k)) * r15mx">
      <Dependency Name="r15ex" />
      <Dependency Name="r15co" />
      <Dependency Name="r15k" />
      <Dependency Name="r15mx" />
    </Number>
    <Number Name="r15fy" Formula="1.5 * r15ey - (1.5 * r15co - sqrt(r15k)) * r15my">
      <Dependency Name="r15ey" />
      <Dependency Name="r15co" />
      <Dependency Name="r15k" />
      <Dependency Name="r15my" />
    </Number>
    <PointByCoordinates Name="r15O" Visible="false" X="r15ox" Y="r15oy">
      <Dependency Name="r15ox" />
      <Dependency Name="r15oy" />
    </PointByCoordinates>
    <PointByCoordinates Name="r15In" Visible="false" X="if(r15hit, r15hx, r15ox + dx)" Y="if(r15hit, r15hy, r15oy + dy)">
      <Dependency Name="r15hit" />
      <Dependency Name="r15hx" />
      <Dependency Name="r15ox" />
      <Dependency Name="dx" />
      <Dependency Name="r15hy" />
      <Dependency Name="r15oy" />
      <Dependency Name="dy" />
    </PointByCoordinates>
    <PointByCoordinates Name="r15Out" Visible="false" X="if(r15hit, r15gx, r15ox + dx)" Y="if(r15hit, r15gy, r15oy + dy)">
      <Dependency Name="r15hit" />
      <Dependency Name="r15gx" />
      <Dependency Name="r15ox" />
      <Dependency Name="dx" />
      <Dependency Name="r15gy" />
      <Dependency Name="r15oy" />
      <Dependency Name="dy" />
    </PointByCoordinates>
    <PointByCoordinates Name="r15On" Visible="false" X="if(r15hit, r15gx + r15fx, r15ox + 2 * dx)" Y="if(r15hit, r15gy + r15fy, r15oy + 2 * dy)">
      <Dependency Name="r15hit" />
      <Dependency Name="r15gx" />
      <Dependency Name="r15fx" />
      <Dependency Name="r15ox" />
      <Dependency Name="dx" />
      <Dependency Name="r15gy" />
      <Dependency Name="r15fy" />
      <Dependency Name="r15oy" />
      <Dependency Name="dy" />
    </PointByCoordinates>
    <Segment Name="r15SunGlow" Style="SunbeamGlow">
      <Dependency Name="r15O" />
      <Dependency Name="r15In" />
    </Segment>
    <Segment Name="r15Sun" Style="Sunbeam">
      <Dependency Name="r15O" />
      <Dependency Name="r15In" />
    </Segment>
    <Segment Name="r15GlassGlow" Style="SunbeamGlow">
      <Dependency Name="r15In" />
      <Dependency Name="r15Out" />
    </Segment>
    <Segment Name="r15Glass" Style="Sunbeam">
      <Dependency Name="r15In" />
      <Dependency Name="r15Out" />
    </Segment>
    <Ray Name="r15HotGlow" Style="WarmGlow">
      <Dependency Name="r15Out" />
      <Dependency Name="r15On" />
    </Ray>
    <Ray Name="r15Hot" Style="Warm">
      <Dependency Name="r15Out" />
      <Dependency Name="r15On" />
    </Ray>
    <Number Name="r15heat" Formula="if(r15hit * (r15k &gt; 0), (abs((Wick.X - r15gx) * r15fy - (Wick.Y - r15gy) * r15fx) &lt; 0.25) * ((Wick.X - r15gx) * r15fx + (Wick.Y - r15gy) * r15fy &gt; 0), 0)">
      <Dependency Name="r15hit" />
      <Dependency Name="r15k" />
      <Dependency Name="Wick" />
      <Dependency Name="r15gx" />
      <Dependency Name="r15fy" />
      <Dependency Name="r15gy" />
      <Dependency Name="r15fx" />
    </Number>
    <Number Name="beams" Formula="r1heat + r2heat + r3heat + r4heat + r5heat + r6heat + r7heat + r8heat + r9heat + r10heat + r11heat + r12heat + r13heat + r14heat + r15heat">
      <Dependency Name="r1heat" />
      <Dependency Name="r2heat" />
      <Dependency Name="r3heat" />
      <Dependency Name="r4heat" />
      <Dependency Name="r5heat" />
      <Dependency Name="r6heat" />
      <Dependency Name="r7heat" />
      <Dependency Name="r8heat" />
      <Dependency Name="r9heat" />
      <Dependency Name="r10heat" />
      <Dependency Name="r11heat" />
      <Dependency Name="r12heat" />
      <Dependency Name="r13heat" />
      <Dependency Name="r14heat" />
      <Dependency Name="r15heat" />
    </Number>
    <Polygon Name="Saucer" Style="Saucer">
      <Dependency Name="SaucerA" />
      <Dependency Name="SaucerB" />
      <Dependency Name="SaucerC" />
      <Dependency Name="SaucerD" />
    </Polygon>
    <Polygon Name="Wax" Style="Wax">
      <Dependency Name="WaxA" />
      <Dependency Name="WaxB" />
      <Dependency Name="WaxC" />
      <Dependency Name="WaxD" />
    </Polygon>
    <Segment Name="WickLine" Style="Wick">
      <Dependency Name="WickBottom" />
      <Dependency Name="Wick" />
    </Segment>
    <PointByCoordinates Name="Fire" Style="Fire" X="Wick.X + 0 * sqrt(beams - 10.5)" Y="Wick.Y + 0.4">
      <Dependency Name="Wick" />
      <Dependency Name="beams" />
    </PointByCoordinates>
    <Label Name="Title" Style="Heading" Text="Light It with the Sun" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="Explanation" DecimalsToShow="0" Text="Sunlight comes in parallel beams. A lens bends each beam a little, the outer ones more, so that they all squeeze together in one bright, hot spot: the focus. Get enough sunlight onto the wick and the candle lights!\n\nMove the candle, or the lens, until the beams meet right at the wick. Drag the sun up or down and watch the spot move. Pull the handle on the lens: a fatter lens bends harder and its focus comes closer.\n\nLook closely and the beams don't meet in one point: the outer ones cross a bit nearer the lens. Every lens with round sides does that.\n\nBeams on the wick: [beams]. It takes 11.\n\nThe Olympic flame is lit this way at Olympia in Greece, with a curved mirror and the sun." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true">
      <Dependency Name="beams" />
    </Label>
  </Figures>
</Drawing>