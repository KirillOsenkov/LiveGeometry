  <Figures>
    <FreePoint Name="Sun" Style="Sun" X="-9.8" Y="0.8" />
    <FreePoint Name="L" Style="LensKnob" X="0" Y="0" />
    <PointByCoordinates Name="BulgeFrom" Visible="false" X="L.X + 0.2" Y="L.Y">
      <Dependency Name="L" />
    </PointByCoordinates>
    <PointByCoordinates Name="BulgeTo" Visible="false" X="L.X + 1.7" Y="L.Y">
      <Dependency Name="L" />
    </PointByCoordinates>
    <Segment Name="BulgeRail" Visible="false">
      <Dependency Name="BulgeFrom" />
      <Dependency Name="BulgeTo" />
    </Segment>
    <PointOnFigure Name="W" Style="Knob" X="0.4500005" Y="0" Parameter="0.166667">
      <Dependency Name="BulgeRail" />
    </PointOnFigure>
    <Number Name="w" Formula="W.X - L.X">
      <Dependency Name="W" />
      <Dependency Name="L" />
    </Number>
    <Number Name="R" Formula="(5.76 + w^2) / (2 * w)">
      <Dependency Name="w" />
    </Number>
    <PointByCoordinates Name="LeftTop" Visible="false" X="L.X - w" Y="L.Y">
      <Dependency Name="L" />
      <Dependency Name="w" />
    </PointByCoordinates>
    <PointByCoordinates Name="LeftCenter" Visible="false" X="L.X - w + R" Y="L.Y">
      <Dependency Name="L" />
      <Dependency Name="w" />
      <Dependency Name="R" />
    </PointByCoordinates>
    <PointByCoordinates Name="RightCenter" Visible="false" X="L.X + w - R" Y="L.Y">
      <Dependency Name="L" />
      <Dependency Name="w" />
      <Dependency Name="R" />
