<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1">
  <Viewport Left="-7" Top="8" Right="14" Bottom="-8" />
  <Styles>
    <ShapeStyle Name="GivenCircle" Fill="#208854D0" Color="#FF8854D0" StrokeWidth="2.5">
      <Dark Fill="#25B48CFF" Color="#FFB48CFF" />
    </ShapeStyle>
    <ShapeStyle Name="AnswerCircle" Fill="#302E9E4F" Color="#FF2E9E4F" StrokeWidth="3">
      <Dark Fill="#304CD27A" Color="#FF4CD27A" />
    </ShapeStyle>
    <LineStyle Name="CompassCircle" Color="#FF8854D0" StrokeWidth="2.5" Dash="Dash">
      <Dark Color="#FFB48CFF" />
    </LineStyle>
    <LineStyle Name="ScaledCircle" Color="#FF2E9E4F" StrokeWidth="3" Dash="Dash">
      <Dark Color="#FF4CD27A" />
    </LineStyle>
    <PointStyle Name="GreenPoint" Size="8" Fill="#FF7FD69A">
      <Dark Fill="#FF6FCB8C" />
    </PointStyle>
  </Styles>
  <Figures>
    <FreePoint Name="V" Step="GroupWithNext" Description="Given: the angle at V with its two red sides, and inside it the purple circle with center O and radius R. Construct a circle that touches both angle sides and the purple circle." X="0" Y="0" />
    <FreePoint Name="A" Step="GroupWithNext" X="8" Y="6" />
    <FreePoint Name="B" Step="GroupWithNext" X="8" Y="-6" />
    <FreePoint Name="O" Step="GroupWithNext" X="9" Y="2" />
    <FreePoint Name="S" Step="GroupWithNext" X="9" Y="5" />
    <Ray Name="VA" Style="ThickRedLine" Step="GroupWithNext">
      <Dependency Name="V" />
      <Dependency Name="A" />
    </Ray>
    <Ray Name="VB" Style="ThickRedLine" Step="GroupWithNext">
      <Dependency Name="V" />
      <Dependency Name="B" />
    </Ray>
    <Circle Name="Given" Style="GivenCircle" Step="GroupWithNext">
      <Dependency Name="O" />
      <Dependency Name="S" />
    </Circle>
    <Segment Name="OS" Style="PurpleLine" Step="GroupWithNext">
      <Dependency Name="O" />
      <Dependency Name="S" />
    </Segment>
    <AttachedLabel Name="BigRadius" OffsetX="-17" OffsetY="-12" Text="R">
      <Dependency Name="OS" />
    </AttachedLabel>
    <CircleByRadius Name="Compass" Style="CompassCircle" Description="Draw a circle of radius R around V: the purple circle translated to the corner.">
      <Dependency Name="O" />
      <Dependency Name="S" />
      <Dependency Name="V" />
    </CircleByRadius>
    <PerpendicularLine Name="normalA" Visible="false" RightAngleCorner="0">
      <Dependency Name="VA" />
      <Dependency Name="V" />
    </PerpendicularLine>
    <IntersectionPoint Name="Q1" Step="GroupWithNext" Description="Draw a radius of that circle perpendicular to each side, on the outside." Algorithm="IntersectLineAndEllipse1">
      <Dependency Name="normalA" />
      <Dependency Name="Compass" />
    </IntersectionPoint>
    <PerpendicularLine Name="normalB" Visible="false" RightAngleCorner="0">
      <Dependency Name="VB" />
      <Dependency Name="V" />
    </PerpendicularLine>
    <IntersectionPoint Name="Q2" Step="GroupWithNext" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="normalB" />
      <Dependency Name="Compass" />
    </IntersectionPoint>
    <Segment Name="VQ1" Style="PurpleLine" Step="GroupWithNext">
      <Dependency Name="V" />
      <Dependency Name="Q1" />
    </Segment>
    <Segment Name="VQ2" Style="PurpleLine">
      <Dependency Name="V" />
      <Dependency Name="Q2" />
    </Segment>
    <ParallelLine Name="pushedA" Visible="false">
      <Dependency Name="VA" />
      <Dependency Name="Q1" />
    </ParallelLine>
    <ParallelLine Name="pushedB" Visible="false">
      <Dependency Name="VB" />
      <Dependency Name="Q2" />
    </ParallelLine>
    <IntersectionPoint Name="D" Step="GroupWithNext" Description="Through the end of each radius draw a parallel to that side, pushed out by R. The two pushed-out sides intersect at point D." Algorithm="IntersectLineAndLine">
      <Dependency Name="pushedA" />
      <Dependency Name="pushedB" />
    </IntersectionPoint>
    <Ray Name="DQ1" Style="DashedRedLine" Step="GroupWithNext">
      <Dependency Name="D" />
      <Dependency Name="Q1" />
    </Ray>
    <Ray Name="DQ2" Style="DashedRedLine">
      <Dependency Name="D" />
      <Dependency Name="Q2" />
    </Ray>
    <Segment Name="DO" Style="OrangeLine" Step="GroupWithNext" Description="The circle we want, grown by R, passes through O and touches both pushed-out sides, as the dashed purple circle does. We can get it by scaling up from the dashed purple circle. DO intersects the dashed purple circle at P.">
      <Dependency Name="D" />
      <Dependency Name="O" />
    </Segment>
    <IntersectionPoint Name="P" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="DO" />
      <Dependency Name="Compass" />
    </IntersectionPoint>
    <Segment Name="PV" Style="OrangeLine" Step="GroupWithNext" Description="PV is the radius.">
      <Dependency Name="P" />
      <Dependency Name="V" />
    </Segment>
    <Ray Name="DV" Style="DashDotLine" Description="Ray DV is the angle bisector.">
      <Dependency Name="D" />
      <Dependency Name="V" />
    </Ray>
    <ParallelLine Name="imageOfPV" Visible="false">
      <Dependency Name="PV" />
      <Dependency Name="O" />
    </ParallelLine>
    <IntersectionPoint Name="X" Style="GreenPoint" Step="GroupWithNext" Algorithm="IntersectLineAndLine">
      <Dependency Name="DV" />
      <Dependency Name="imageOfPV" />
    </IntersectionPoint>
    <Segment Name="OX" Style="OrangeLine" Description="The scaling from D takes P to O and V to X, so OX is parallel to PV.">
      <Dependency Name="O" />
      <Dependency Name="X" />
    </Segment>
    <Circle Name="Scaled" Style="ScaledCircle" Description="The dashed green circle around X through O is the scaled-up circle: it touches both pushed-out sides and passes through O.">
      <Dependency Name="X" />
      <Dependency Name="O" />
    </Circle>
    <IntersectionPoint Name="K" Step="GroupWithNext" Description="Shrink it by R: XO meets the purple circle at K, so XK = XO − R = r." Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="OX" />
      <Dependency Name="Given" />
    </IntersectionPoint>
    <Segment Name="KX" Style="GreenLine" Step="GroupWithNext">
      <Dependency Name="X" />
      <Dependency Name="K" />
    </Segment>
    <AttachedLabel Name="SmallRadius" OffsetX="-10.443883435612406" OffsetY="-28.83974682122141" Text="r">
      <Dependency Name="KX" />
    </AttachedLabel>
    <Circle Name="Answer" Style="AnswerCircle" Description="The green circle around X through K is the answer: it touches both sides of the angle and the purple circle.">
      <Dependency Name="X" />
      <Dependency Name="K" />
    </Circle>
    <PointLabel Name="LabelV" OffsetX="-5" OffsetY="8">
      <Dependency Name="V" />
    </PointLabel>
    <PointLabel Name="LabelO" OffsetX="3.5" OffsetY="-30.186533479473212">
      <Dependency Name="O" />
    </PointLabel>
    <PointLabel Name="LabelD" OffsetX="-6.5" OffsetY="-29">
      <Dependency Name="D" />
    </PointLabel>
    <PointLabel Name="LabelP" OffsetX="-0.3324381430520589" OffsetY="-30.352590699492282">
      <Dependency Name="P" />
    </PointLabel>
    <PointLabel Name="LabelX" OffsetX="-5.5" OffsetY="-29">
      <Dependency Name="X" />
    </PointLabel>
    <PointLabel Name="LabelK" OffsetX="-0.3324381430520589" OffsetY="-30.352590699492282">
      <Dependency Name="K" />
    </PointLabel>
    <Label Name="Title" Style="Heading" Text="Fit a Circle in the Corner" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="Explanation" Text="The purple circle with center O and radius R lies inside the red angle at V. Find the green circle that touches both sides of the angle and the purple circle.\n\nCall its center X and radius r. Grow it by R: the circle around X of radius r + R passes through O and touches the two sides pushed out by R. So push the sides out, find a circle through O touching the pushed-out sides, and shrink it back.\n\n1. Push the sides out. Draw the circle of radius R around V (dashed purple) and a radius perpendicular to each side. Through its end draw a parallel to that side (dashed red): the side pushed out by R. The two pushed-out sides meet at D.\n\n2. Scale from D. Both the dashed purple circle and the circle through O that we want touch the pushed-out sides, so one is the other scaled up from D, where the sides meet. DO meets the dashed purple circle at P on the far side. The scaling takes P to O and V to X, so OX is parallel to PV: the parallel to PV through O meets DV, the bisector of the angle, at X. The dashed green circle around X through O is the scaled-up circle.\n\n3. Shrink by R. XO meets the purple circle at K, so XK = XO − R = r. The green circle around X through K is the answer.\n\nDrag the yellow points. With the nearer crossing of DO in place of P, the same steps produce a second circle, on the far side of the purple one." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true" />
  </Figures>
</Drawing>