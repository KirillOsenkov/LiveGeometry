<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1">
  <Viewport Left="-2.375" Top="-0.0416666667" Right="7.625" Bottom="-15.2083333333" />
  <Styles>
    <LineStyle Name="4" Color="#FF6363EB" StrokeWidth="3" />
    <LineStyle Name="9" Color="#FF57C242" />
    <LineStyle Name="10" Color="#FFA7A7A7" />
    <LineStyle Name="12" Color="#FFEB4444" StrokeWidth="3" />
  </Styles>
  <Figures>
    <FreePoint Name="A" Step="GroupWithNext" Description="The triangle ABC. Find the circle that touches all three sides." X="-1.7083333333" Y="-8.6875" />
    <FreePoint Name="B" Step="GroupWithNext" X="6.5416666667" Y="-5.875" />
    <Segment Name="AB" Style="4" Step="GroupWithNext">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <FreePoint Name="C" Step="GroupWithNext" X="5.625" Y="-12.2083333333" />
    <Segment Name="BC" Style="4" Step="GroupWithNext">
      <Dependency Name="C" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="AC" Style="4">
      <Dependency Name="A" />
      <Dependency Name="C" />
    </Segment>
    <AngleBisector Name="g" Style="9" Description="The bisector of the angle at A: every point on it is as far from AB as from AC.">
      <Dependency Name="A" />
      <Dependency Name="C" />
      <Dependency Name="B" />
    </AngleBisector>
    <AngleBisector Name="h" Style="9" Step="GroupWithNext" Description="The bisector of the angle at C meets it at D, which is as far from all three sides.">
      <Dependency Name="C" />
      <Dependency Name="B" />
      <Dependency Name="A" />
    </AngleBisector>
    <IntersectionPoint Name="D" Style="DependentPoint" Algorithm="IntersectLineAndLine">
      <Dependency Name="h" />
      <Dependency Name="g" />
    </IntersectionPoint>
    <AngleBisector Name="k" Style="9" Description="The bisector of the angle at B passes through D as well.">
      <Dependency Name="B" />
      <Dependency Name="A" />
      <Dependency Name="C" />
    </AngleBisector>
    <PerpendicularLine Name="m" Style="10" Step="GroupWithNext" Description="The perpendicular from D to AC meets the side at E, the point of AC nearest to D." RightAngleCorner="1">
      <Dependency Name="AC" />
      <Dependency Name="D" />
    </PerpendicularLine>
    <IntersectionPoint Name="E" Style="PointOnFigure" Algorithm="IntersectLineAndLine">
      <Dependency Name="m" />
      <Dependency Name="AC" />
    </IntersectionPoint>
    <Circle Name="c" Style="12" Description="The circle around D through E touches all three sides: the incircle.">
      <Dependency Name="D" />
      <Dependency Name="E" />
    </Circle>
    <Label Name="Title" Style="Heading" Text="Inscribed Circle" Pin="TopRight" OffsetX="16" OffsetY="36.25" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="Explanation" Text="Every triangle has exactly one circle that touches all three sides: its incircle.\n\nThe green lines are the angle bisectors. They always meet in a single point, the incenter (gray) — the center of the incircle. A perpendicular from the incenter to a side gives the green point where the circle touches.\n\nDrag the yellow vertices: the circle always fits." Pin="TopRight" OffsetX="16" OffsetY="84.25" WrapWidth="400" Backdrop="true" />
  </Figures>
</Drawing>