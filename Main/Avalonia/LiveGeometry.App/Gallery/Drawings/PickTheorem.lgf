    <Label Name="Title" Style="GalleryTitle" Text="Pick's Theorem" Pin="TopRight" OffsetX="16" OffsetY="36.25" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="The corners of this polygon sit on grid points. Count the grid points inside it (I) and on its boundary (B). Then the area is\n\nArea = I + B/2 − 1\n\nRight now the area is [area(A, B, C, D, E, F, G, H)].\n\nHold Shift and drag the corners to new grid points — the formula keeps working." Pin="TopRight" OffsetX="16" OffsetY="84.25" WrapWidth="400" Backdrop="true">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
      <Dependency Name="E" />
      <Dependency Name="F" />
      <Dependency Name="G" />
      <Dependency Name="H" />
    </Label>
  </Figures>
