    <PointByCoordinates Name="C" Visible="false" X="x" Y="0.5">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Rim" Visible="false" X="x + 0.5" Y="0.5">
      <Dependency Name="x" />
    </PointByCoordinates>
    <Circle Name="Wheel" Style="Wheel">
      <Dependency Name="C" />
      <Dependency Name="Rim" />
    </Circle>
    <PointByCoordinates Name="Bottom" Visible="false" X="x" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Top" Visible="false" X="x" Y="1">
      <Dependency Name="x" />
    </PointByCoordinates>
    <Segment Name="Across" Style="Across">
      <Dependency Name="Bottom" />
      <Dependency Name="Top" />
    </Segment>
    <PointByCoordinates Name="SpokeEnd" Visible="false" X="x + 0.5 * cos(-pi / 2 - 2 * x)" Y="0.5 + 0.5 * sin(-pi / 2 - 2 * x)">
      <Dependency Name="x" />
    </PointByCoordinates>
    <Segment Name="Spoke" Style="Spoke">
      <Dependency Name="C" />
      <Dependency Name="SpokeEnd" />
    </Segment>
    <PointByCoordinates Name="Contact" Style="Contact" X="x" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Flat0a" Visible="false" X="clamp(0, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Flat0b" Visible="false" X="clamp(1, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <Segment Name="Flat0" Style="StripeA">
      <Dependency Name="Flat0a" />
      <Dependency Name="Flat0b" />
    </Segment>
    <PointByCoordinates Name="Flat1a" Visible="false" X="clamp(1, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Flat1b" Visible="false" X="clamp(2, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <Segment Name="Flat1" Style="StripeB">
      <Dependency Name="Flat1a" />
      <Dependency Name="Flat1b" />
    </Segment>
    <PointByCoordinates Name="Flat2a" Visible="false" X="clamp(2, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Flat2b" Visible="false" X="clamp(3, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
