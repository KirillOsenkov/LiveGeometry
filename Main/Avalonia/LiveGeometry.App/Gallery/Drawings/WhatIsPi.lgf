    <PointByCoordinates Name="0" Visible="false" X="0" Y="-0.12" />
    <PointByCoordinates Name="1" Visible="false" X="1" Y="-0.12" />
    <PointByCoordinates Name="2" Visible="false" X="2" Y="-0.12" />
    <PointByCoordinates Name="3" Visible="false" X="3" Y="-0.12" />
    <PointByCoordinates Name="π" Visible="false" X="3.141593" Y="-0.12" />
    <PointByCoordinates Name="Tick0" Visible="false" X="0" Y="0" />
    <PointByCoordinates Name="Tick1" Visible="false" X="1" Y="0" />
    <PointByCoordinates Name="Tick2" Visible="false" X="2" Y="0" />
