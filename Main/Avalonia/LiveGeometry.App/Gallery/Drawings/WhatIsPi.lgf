      <Dependency Name="Flat2a" />
      <Dependency Name="Flat2b" />
    </Segment>
    <PointByCoordinates Name="Flat3a" Visible="false" X="clamp(3, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Flat3b" Visible="false" X="clamp(pi, 0, x)" Y="0">
      <Dependency Name="x" />
    </PointByCoordinates>
    <Segment Name="Flat3" Style="StripeC">
      <Dependency Name="Flat3a" />
      <Dependency Name="Flat3b" />
    </Segment>
    <PointByCoordinates Name="Round0a" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(0, x, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(0, x, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Round0b" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(1, x + 0.0001, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(1, x + 0.0001, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <CircleArc Name="Round0" Style="StripeA">
      <Dependency Name="C" />
      <Dependency Name="Round0a" />
      <Dependency Name="Round0b" />
    </CircleArc>
    <PointByCoordinates Name="Round1a" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(1, x, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(1, x, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Round1b" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(2, x + 0.0001, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(2, x + 0.0001, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <CircleArc Name="Round1" Style="StripeB">
      <Dependency Name="C" />
      <Dependency Name="Round1a" />
      <Dependency Name="Round1b" />
    </CircleArc>
    <PointByCoordinates Name="Round2a" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(2, x, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(2, x, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Round2b" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(3, x + 0.0001, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(3, x + 0.0001, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <CircleArc Name="Round2" Style="StripeA">
      <Dependency Name="C" />
      <Dependency Name="Round2a" />
      <Dependency Name="Round2b" />
    </CircleArc>
    <PointByCoordinates Name="Round3a" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(3, x, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(3, x, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <PointByCoordinates Name="Round3b" Visible="false" X="x + 0.5 * cos(-pi / 2 + 2 * (clamp(pi, x + 0.0001, pi) - x))" Y="0.5 + 0.5 * sin(-pi / 2 + 2 * (clamp(pi, x + 0.0001, pi) - x))">
      <Dependency Name="x" />
    </PointByCoordinates>
    <CircleArc Name="Round3" Style="StripeC">
      <Dependency Name="C" />
      <Dependency Name="Round3a" />
      <Dependency Name="Round3b" />
    </CircleArc>
    <Label Name="Unrolled" Style="Big" DecimalsToShow="3" Text="[x] unrolled so far" X="0.9" Y="1.55">
      <Dependency Name="x" />
    </Label>
    <Label Name="Title" Style="GalleryTitle" Text="What Is π?" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="A wheel exactly 1 across rolls along a ruler, and its rim is painted: dark blue, light blue, dark blue, then a short red bit. Drag the slider to roll it. Every bit of paint that touches the ruler stays on it, so the painted line on the ruler is exactly as long as the distance around the wheel.\n\nRoll it all the way. The paint reaches past 3 and stops at 3.14159... That number is π: for every wheel, every coin and every planet, the distance around is π times the distance across. Never a bit more, never a bit less.\n\nThe digits of π go on forever without repeating. People have computed trillions of them, but to steer a spaceship across the solar system you only need about fifteen." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true" />
  </Figures>
</Drawing>