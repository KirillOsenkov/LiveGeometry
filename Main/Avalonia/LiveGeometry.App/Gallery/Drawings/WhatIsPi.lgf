      <Dependency Name="π" />
    </Segment>
    <PointLabel Name="Mark0" Style="Mark" IsHitTestVisible="false" OffsetX="-4" OffsetY="2" ShowName="true" ShowCoordinates="false">
      <Dependency Name="0" />
    </PointLabel>
    <PointLabel Name="Mark1" Style="Mark" IsHitTestVisible="false" OffsetX="-4" OffsetY="2" ShowName="true" ShowCoordinates="false">
      <Dependency Name="1" />
