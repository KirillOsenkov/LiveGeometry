    <PointStyle Name="Contact" Size="9" Fill="#FFFFE066" Color="#FF806000" StrokeWidth="1.5" />
    <TextStyle Name="Mark" FontSize="15" Color="#FF2B3038" FontFamily="Segoe UI">
      <Dark Color="#FFE4E8F0" />
    </TextStyle>
    <TextStyle Name="Big" FontSize="22" Color="#FFE0362B" FontFamily="Segoe UI" Bold="true">
      <Dark Color="#FFFF6B5E" />
    </TextStyle>
  </Styles>
  <Figures>
    <Slider Name="x" X="-0.5" Y="-1.3" Value="2" Maximum="3.14159265358979" Decimals="3" />
    <PointByCoordinates Name="GroundL" Visible="false" X="-0.5" Y="0" />
    <PointByCoordinates Name="GroundR" Visible="false" X="4.2" Y="0" />
    <Segment Name="Ground" Style="Ground">
      <Dependency Name="GroundL" />
      <Dependency Name="GroundR" />
