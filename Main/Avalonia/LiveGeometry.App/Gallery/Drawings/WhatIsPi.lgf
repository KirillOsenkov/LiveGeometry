<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1" Creator="LiveGeometry.App">
  <Viewport Left="-1" Top="2.5" Right="4.5" Bottom="-2" />
  <Styles>
    <LineStyle Name="Ground" Color="#FF8A94A6" StrokeWidth="1.5" />
    <LineStyle Name="Tick" Color="#FF8A94A6" StrokeWidth="1.5" />
