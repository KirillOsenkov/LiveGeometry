    <PointStyle Name="Peg" Size="8" Fill="#FF3B4250" Color="#FF3B4250">
      <Dark Fill="#FFD8DCE4" Color="#FFD8DCE4" />
    </PointStyle>
    <PointStyle Name="Goat" Character="🐐" Size="40" Fill="#FFFFFFFF" />
  </Styles>
  <Figures>
    <Slider Name="r" X="-5" Y="-5.4" Value="4" Maximum="5" />
    <PointByCoordinates Name="A" Style="Peg" X="0" Y="0" />
    <PointByCoordinates Name="B" Visible="false" X="3" Y="0" />
    <PointByCoordinates Name="C" Visible="false" X="3" Y="2" />
    <PointByCoordinates Name="D" Visible="false" X="0" Y="2" />
    <Polygon Name="Barn" Style="Barn" Z="1">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <AttachedLabel Name="BarnLabel" Style="BarnName" OffsetX="-19.75" OffsetY="-12" Text="Barn">
      <Dependency Name="Barn" />
    </AttachedLabel>
    <PointByCoordinates Name="FrontUp" Visible="false" X="0" Y="r">
      <Dependency Name="r" />
    </PointByCoordinates>
    <PointByCoordinates Name="FrontRight" Visible="false" X="r" Y="0">
      <Dependency Name="r" />
    </PointByCoordinates>
    <CircleSector Name="Front" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="FrontUp" />
      <Dependency Name="FrontRight" />
    </CircleSector>
    <PointByCoordinates Name="SideOut" Visible="false" X="3 + max(r - 3, 0)" Y="0">
      <Dependency Name="r" />
    </PointByCoordinates>
    <PointByCoordinates Name="SideUp" Visible="false" X="3" Y="max(r - 3, 0)">
      <Dependency Name="r" />
    </PointByCoordinates>
    <CircleSector Name="Side" Visible="false">
      <Dependency Name="B" />
      <Dependency Name="SideOut" />
      <Dependency Name="SideUp" />
    </CircleSector>
    <PointByCoordinates Name="BackOut" Visible="false" X="max(r - 2, 0)" Y="2">
      <Dependency Name="r" />
