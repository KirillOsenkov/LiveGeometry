      <Dependency Name="D" />
      <Dependency Name="BackOut" />
      <Dependency Name="BackUp" />
    </CircleSector>
    <Region Name="Grass" Style="Grass" Operation="Union">
      <Dependency Name="Front" />
      <Dependency Name="Side" />
      <Dependency Name="Back" />
    </Region>
    <PointInRegion Name="Goat" Style="Goat" X="-2" Y="-1.5000000000000027" OffsetX="-1.6168040655898297" OffsetY="-1.2111436882313393">
      <Dependency Name="Grass" />
    </PointInRegion>
    <Label Name="Title" Style="Heading" Text="The Grazing Goat" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="Explanation" Text="A goat is tied to the corner of a barn with a rope. How much grass can it reach? Drag the slider to let out more rope. In front of the barn the goat sweeps three quarters of a circle; where the rope bends around a corner, what is left of it sweeps a quarter circle more.\n\nGrass it can reach: [Grass.Area]. The formula, 3/4 of π r² plus a quarter circle for each corner the rope gets around: [3 / 4 * pi * r^2 + pi / 4 * max(r - 3, 0)^2 + pi / 4 * max(r - 2, 0)^2]. The barn is 3 by 2.\n\nThe reach is a Union of three sectors, and the goat is a point kept inside it: drag it anywhere on the grass, but not into the barn." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true">
      <Dependency Name="Grass" />
      <Dependency Name="r" />
    </Label>
  </Figures>
</Drawing>