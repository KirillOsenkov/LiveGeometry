<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1">
  <Viewport Left="-7" Top="6" Right="7" Bottom="-7" />
  <Scene Left="-5.5" Top="5.5" Right="5.75" Bottom="-6.25" />
  <Styles>
    <ShapeStyle Name="Barn" Fill="#FFD9A066" Color="#FF8A5A2B" StrokeWidth="2">
      <Dark Fill="#FF8A5A2B" Color="#FFE0B080" />
    </ShapeStyle>
    <TextStyle Name="BarnName" FontSize="18" Color="#FF5A3A14" FontFamily="Segoe UI" Bold="true">
      <Dark Color="#FFF0D8B0" />
    </TextStyle>
    <ShapeStyle Name="Grass" Fill="#B0BDEFB0" Color="#FF4CA85A" StrokeWidth="1.5">
