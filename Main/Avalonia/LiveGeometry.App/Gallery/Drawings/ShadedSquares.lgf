    </PointByCoordinates>
    <Polygon Name="EFGH" Style="Frame">
      <Dependency Name="E" />
      <Dependency Name="F" />
      <Dependency Name="G" />
      <Dependency Name="H" />
    </Polygon>
    <PointByCoordinates Name="BottomMid" Visible="false" X="1.5 * s + 1" Y="0">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="RightMid" Visible="false" X="2 * s + 1" Y="s / 2">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="TopMid" Visible="false" X="1.5 * s + 1" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="LeftMid" Visible="false" X="s + 1" Y="s / 2">
      <Dependency Name="s" />
    </PointByCoordinates>
    <CircleSegment Name="HalfBottom" Visible="false">
      <Dependency Name="BottomMid" />
      <Dependency Name="F" />
      <Dependency Name="E" />
    </CircleSegment>
    <CircleSegment Name="HalfRight" Visible="false">
      <Dependency Name="RightMid" />
      <Dependency Name="G" />
      <Dependency Name="F" />
    </CircleSegment>
    <CircleSegment Name="HalfTop" Visible="false">
      <Dependency Name="TopMid" />
      <Dependency Name="H" />
      <Dependency Name="G" />
    </CircleSegment>
    <CircleSegment Name="HalfLeft" Visible="false">
      <Dependency Name="LeftMid" />
      <Dependency Name="E" />
      <Dependency Name="H" />
    </CircleSegment>
    <Region Name="Petal1" Visible="false" Operation="Intersection">
      <Dependency Name="HalfBottom" />
      <Dependency Name="HalfRight" />
    </Region>
    <Region Name="Petal2" Visible="false" Operation="Intersection">
      <Dependency Name="HalfRight" />
      <Dependency Name="HalfTop" />
    </Region>
    <Region Name="Petal3" Visible="false" Operation="Intersection">
      <Dependency Name="HalfTop" />
      <Dependency Name="HalfLeft" />
    </Region>
    <Region Name="Petal4" Visible="false" Operation="Intersection">
      <Dependency Name="HalfLeft" />
      <Dependency Name="HalfBottom" />
    </Region>
    <Region Name="Flower" Style="Flower" Operation="Union">
      <Dependency Name="Petal1" />
      <Dependency Name="Petal2" />
      <Dependency Name="Petal3" />
      <Dependency Name="Petal4" />
    </Region>
    <PointByCoordinates Name="I" Visible="false" X="2 * s + 2" Y="0">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="J" Visible="false" X="3 * s + 2" Y="0">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="K" Visible="false" X="3 * s + 2" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="L" Visible="false" X="2 * s + 2" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
    <Polygon Name="IJKL" Style="Frame">
      <Dependency Name="I" />
      <Dependency Name="J" />
      <Dependency Name="K" />
      <Dependency Name="L" />
    </Polygon>
    <PointByCoordinates Name="IJ" Visible="false" X="2.5 * s + 2" Y="0">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="JK" Visible="false" X="3 * s + 2" Y="s / 2">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="KL" Visible="false" X="2.5 * s + 2" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="LI" Visible="false" X="2 * s + 2" Y="s / 2">
      <Dependency Name="s" />
    </PointByCoordinates>
    <CircleSector Name="CornerI" Visible="false">
      <Dependency Name="I" />
      <Dependency Name="IJ" />
      <Dependency Name="LI" />
    </CircleSector>
    <CircleSector Name="CornerJ" Visible="false">
      <Dependency Name="J" />
      <Dependency Name="JK" />
      <Dependency Name="IJ" />
    </CircleSector>
    <CircleSector Name="CornerK" Visible="false">
      <Dependency Name="K" />
      <Dependency Name="KL" />
      <Dependency Name="JK" />
    </CircleSector>
    <CircleSector Name="CornerL" Visible="false">
      <Dependency Name="L" />
      <Dependency Name="LI" />
      <Dependency Name="KL" />
