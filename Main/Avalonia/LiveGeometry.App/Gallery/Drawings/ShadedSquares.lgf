    </PointByCoordinates>
    <PointByCoordinates Name="C" Visible="false" X="s" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="D" Visible="false" X="0" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
    <Polygon Name="ABCD" Style="Frame">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <CircleSector Name="QuarterA" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="D" />
    </CircleSector>
    <CircleSector Name="QuarterC" Visible="false">
      <Dependency Name="C" />
      <Dependency Name="D" />
      <Dependency Name="B" />
    </CircleSector>
    <Region Name="Leaf" Style="Leaf" Operation="Intersection">
      <Dependency Name="QuarterA" />
      <Dependency Name="QuarterC" />
    </Region>
    <PointByCoordinates Name="E" Visible="false" X="s + 1" Y="0">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="F" Visible="false" X="2 * s + 1" Y="0">
      <Dependency Name="s" />
    </PointByCoordinates>
    <PointByCoordinates Name="G" Visible="false" X="2 * s + 1" Y="s">
      <Dependency Name="s" />
    </PointByCoordinates>
