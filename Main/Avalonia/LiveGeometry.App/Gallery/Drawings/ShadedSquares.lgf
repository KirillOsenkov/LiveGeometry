    <Region Name="Star" Style="Star" Operation="Difference">
      <Dependency Name="IJKL" />
      <Dependency Name="CornerI" />
      <Dependency Name="CornerJ" />
      <Dependency Name="CornerK" />
      <Dependency Name="CornerL" />
    </Region>
    <AreaMeasurement Name="LeafArea" OffsetX="-16.75" OffsetY="-12">
      <Dependency Name="Leaf" />
    </AreaMeasurement>
    <AreaMeasurement Name="FlowerArea" OffsetX="11.25" OffsetY="-40">
      <Dependency Name="Flower" />
    </AreaMeasurement>
    <AreaMeasurement Name="StarArea" OffsetX="-16.75" OffsetY="-12">
      <Dependency Name="Star" />
    </AreaMeasurement>
    <Label Name="Title" Style="Heading" Text="Shaded Squares" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="Explanation" Text="Three puzzles from the back of every geometry book: find the shaded area. In the first square, two quarter circles overlap in a leaf. In the second, four half circles overlap in a flower. In the third, four quarter circles leave a star in the middle.\n\nDrag the slider to change the side. The leaf and the flower always have the same area, (π/2 − 1) of the square: [(pi / 2 - 1) * s^2]. The star is what is left when a whole circle's worth of quarters is taken away, (1 − π/4) of the square: [(1 - pi / 4) * s^2].\n\nThe shaded shapes are made with Intersection (the leaf, and each petal), Union (the flower from its petals) and Difference (the star)." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true">
      <Dependency Name="s" />
    </Label>
  </Figures>
</Drawing>