    <Label Name="Hint" Visible="false" Style="GalleryText" Text="Move Skull Rock one step. Each flag moves one step too, but turned a quarter turn: one flag to the left, the other to the right. Those are opposite directions, so the flags move apart or together evenly, and the point halfway between them stays put. Try it: put Skull Rock halfway between the palms and follow the map." Pin="TopRight" OffsetX="16" OffsetY="300" WrapWidth="400" Backdrop="true" />
    <ShowHideControl Name="Hint box" Style="GalleryText" Show="false" Text="Hint" X="-1.45" Y="-1">
      <Dependency Name="Secret" />
      <Dependency Name="Corner" />
      <Dependency Name="Hint" />
    </ShowHideControl>
    <Label Name="Title" Style="GalleryTitle" Text="Treasure Island" Pin="TopRight" OffsetX="16" OffsetY="16" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="A pirate's map says: Start at Skull Rock. Walk to the big palm, turn right and walk as far again, and plant a flag. Go back to Skull Rock, walk to the little palm, turn left and walk as far again, and plant a flag. The treasure is halfway between the flags.\n\nBut Skull Rock washed away long ago! Drag it anywhere. Where is the treasure now? Check &quot;Hint&quot; to see why." Pin="TopRight" OffsetX="16" OffsetY="64" WrapWidth="400" Backdrop="true" />
  </Figures>
