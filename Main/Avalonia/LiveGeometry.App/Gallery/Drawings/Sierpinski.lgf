    <Label Name="Title" Style="GalleryTitle" Text="Sierpinski Triangle" Pin="TopRight" OffsetX="16" OffsetY="46.75" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="GalleryText" Text="Take a triangle, connect the midpoints of its sides, and you get four smaller triangles. Leave the middle one empty and repeat with the other three — again and again.\n\nThe result is a fractal: it looks the same however closely you zoom in. This one has four levels.\n\nDrag the three corners." Pin="TopRight" OffsetX="16" OffsetY="94.75" WrapWidth="400" Backdrop="true" />
