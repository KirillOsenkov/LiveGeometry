<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1">
  <Viewport Left="-12.3858506944" Top="19.5630787036" Right="9.7669270833" Bottom="-17.3582175925" />
  <Styles>
    <PointStyle Name="1" Fill="#FFFFFF00" Color="#FFB2A12F" StrokeWidth="1.8" />
    <PointStyle Name="2" Fill="#FFE3E1E1" Color="#FF969494" />
    <PointStyle Name="3" Fill="#FF00E5FF" Color="#FF000000">
      <Dark Color="#FFD1D1D1" />
    </PointStyle>
    <ShapeStyle Name="5" Fill="#FFEBF5FF" Color="#FFEDFEFC" StrokeWidth="0.1">
      <Dark Fill="#FF3C4C5C" Color="#FF3C4C5C" />
    </ShapeStyle>
    <LineStyle Name="8" Color="#FF8EC3F8" StrokeWidth="5.4" />
    <LineStyle Name="9" Color="#FF6FBEE0" StrokeWidth="1.4" />
    <LineStyle Name="10" Color="#FFB1B1B1" />
  </Styles>
  <Figures>
    <FreePoint Name="A" Style="1" Step="GroupWithNext" Description="The triangle ABC. Find the circle through all three vertices." X="-7.0553385417" Y="-4.8280526621" />
    <FreePoint Name="B" Style="1" Step="GroupWithNext" X="3.9748987268" Y="-4.8280526621" />
    <FreePoint Name="C" Style="1" Step="GroupWithNext" X="0.5135271991" Y="9.3404947916" />
    <Segment Name="AB" Style="9" Step="GroupWithNext">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </Segment>
    <Segment Name="BC" Style="9" Step="GroupWithNext">
      <Dependency Name="C" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="AC" Style="9" Step="GroupWithNext">
      <Dependency Name="A" />
      <Dependency Name="C" />
    </Segment>
    <Polygon Name="ABC" Style="5">
      <Dependency Name="A" />
      <Dependency Name="C" />
      <Dependency Name="B" />
    </Polygon>
    <MidPoint Name="D" Style="2" Step="GroupWithNext" Description="The perpendicular bisector of BC: through its midpoint D, at a right angle. Every point on it is as far from B as from C.">
      <Dependency Name="C" />
      <Dependency Name="B" />
    </MidPoint>
    <PerpendicularLine Name="g" Style="10" RightAngleCorner="2">
      <Dependency Name="BC" />
      <Dependency Name="D" />
    </PerpendicularLine>
    <MidPoint Name="E" Style="2" Step="GroupWithNext" Description="The perpendicular bisector of AB, the same way: every point on it is as far from A as from B.">
      <Dependency Name="B" />
      <Dependency Name="A" />
    </MidPoint>
    <PerpendicularLine Name="h" Style="10" RightAngleCorner="3">
      <Dependency Name="AB" />
      <Dependency Name="E" />
    </PerpendicularLine>
    <IntersectionPoint Name="O" Style="3" Description="They meet at O, which is as far from A as from B as from C." Algorithm="IntersectLineAndLine">
      <Dependency Name="h" />
      <Dependency Name="g" />
    </IntersectionPoint>
    <Circle Name="c" Style="8" Description="The circle around O through B passes through A and C as well: the circumcircle.">
      <Dependency Name="O" />
      <Dependency Name="B" />
    </Circle>
    <MidPoint Name="F" Style="2" Step="GroupWithNext" Description="The third perpendicular bisector, of AC, passes through O too.">
      <Dependency Name="C" />
      <Dependency Name="A" />
    </MidPoint>
    <PerpendicularLine Name="k" Style="10" RightAngleCorner="3">
      <Dependency Name="AC" />
      <Dependency Name="F" />
    </PerpendicularLine>
    <Label Name="Title" Style="Heading" Text="Circumscribed Circle" Pin="TopRight" OffsetX="16" OffsetY="36.25" WrapWidth="400" Backdrop="true" />
    <Label Name="Description" Style="Explanation" Text="Every triangle has exactly one circle through all three vertices: its circumcircle.\n\nThe gray points are the midpoints of the sides, and the gray lines are the perpendicular bisectors. They always meet in one point, the circumcenter — the center of the circle.\n\nDrag the yellow vertices. When does the center leave the triangle?" Pin="TopRight" OffsetX="16" OffsetY="84.25" WrapWidth="400" Backdrop="true" />
  </Figures>
</Drawing>