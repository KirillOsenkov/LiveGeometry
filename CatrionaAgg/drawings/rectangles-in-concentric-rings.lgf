<?xml version="1.0" encoding="utf-8"?>
<Drawing Version="1">
  <Viewport Left="-5.7" Top="5.7" Right="5.7" Bottom="-5.7" />
  <Scene Left="-5.7" Top="5.7" Right="5.7" Bottom="-5.7" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Purple" Color="#00000000" StrokeWidth="2.5" Fill="#FFAA80E8" Texture="Crayon">
      <Dark Texture="None">
        <Fill>
          <LinearGradientBrush>
            <GradientStop Color="#FF8B4CE8" />
            <GradientStop Color="#FF6C2DC9" Offset="1" />
          </LinearGradientBrush>
        </Fill>
      </Dark>
    </ShapeStyle>
    <ShapeStyle Name="Blue" Color="#00000000" StrokeWidth="2.5" Fill="#FF8EDFF9" Texture="Crayon">
      <Dark Texture="None">
        <Fill>
          <LinearGradientBrush>
            <GradientStop Color="#FF4FC7ED" />
            <GradientStop Color="#FF30A8CE" Offset="1" />
          </LinearGradientBrush>
        </Fill>
      </Dark>
    </ShapeStyle>
    <ShapeStyle Name="Frame" Color="#FF1E1E1E" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FFE6E6E6" />
    </ShapeStyle>
    <ShapeStyle Name="Rectangle" Color="#FF0A08CC" StrokeWidth="3" IsFilled="false">
      <Dark Color="#FF9F9EFA" />
    </ShapeStyle>
  </Styles>
  <Figures>
    <PointByCoordinates Name="O" Visible="false" X="0" Y="0" />
    <PointByCoordinates Name="p1" Visible="false" X="1" Y="0" />
    <PointByCoordinates Name="p2" Visible="false" X="2.5" Y="0" />
    <Segment Name="track3" Visible="false">
      <Dependency Name="p1" />
      <Dependency Name="p2" />
    </Segment>
    <PointOnFigure Name="H" Style="Handle" X="1.75" Y="0" Parameter="0.5">
      <Dependency Name="track3" />
    </PointOnFigure>
    <Number Name="r2" Formula="sqrt((25 + 3 * H.X ^ 2) / 4)">
      <Dependency Name="H" />
    </Number>
    <Number Name="r3" Formula="sqrt(2 * r2 ^ 2 - H.X ^ 2)">
      <Dependency Name="r2" />
      <Dependency Name="H" />
    </Number>
    <Number Name="y1" Formula="sqrt(r2 ^ 2 - H.X ^ 2)">
      <Dependency Name="r2" />
      <Dependency Name="H" />
    </Number>
    <Number Name="y2" Formula="sqrt(r3 ^ 2 - H.X ^ 2)">
      <Dependency Name="r3" />
      <Dependency Name="H" />
    </Number>
    <PointByCoordinates Name="p4" Visible="false" X="H.X" Y="0">
      <Dependency Name="H" />
    </PointByCoordinates>
    <PointByCoordinates Name="p5" Visible="false" X="r2" Y="0">
      <Dependency Name="r2" />
    </PointByCoordinates>
    <PointByCoordinates Name="p6" Visible="false" X="r3" Y="0">
      <Dependency Name="r3" />
    </PointByCoordinates>
    <PointByCoordinates Name="p7" Visible="false" X="5" Y="0" />
    <Circle Name="c8" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="p4" />
    </Circle>
    <Circle Name="c9" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="p5" />
    </Circle>
    <Circle Name="c10" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="p6" />
    </Circle>
    <Circle Name="c11" Visible="false">
      <Dependency Name="O" />
      <Dependency Name="p7" />
    </Circle>
    <Region Name="r12" Style="Purple" Operation="Difference">
      <Dependency Name="c11" />
      <Dependency Name="c10" />
    </Region>
    <Region Name="r13" Style="Blue" Operation="Difference">
      <Dependency Name="c9" />
      <Dependency Name="c8" />
    </Region>
    <Circle Name="c14" Style="Frame">
      <Dependency Name="O" />
      <Dependency Name="p4" />
    </Circle>
    <Circle Name="c15" Style="Frame">
      <Dependency Name="O" />
      <Dependency Name="p5" />
    </Circle>
    <Circle Name="c16" Style="Frame">
      <Dependency Name="O" />
      <Dependency Name="p6" />
    </Circle>
    <Circle Name="c17" Style="Frame">
      <Dependency Name="O" />
      <Dependency Name="p7" />
    </Circle>
    <PointByCoordinates Name="p18" Visible="false" X="H.X" Y="-y1">
      <Dependency Name="H" />
      <Dependency Name="y1" />
    </PointByCoordinates>
    <PointByCoordinates Name="p19" Visible="false" X="r2" Y="-y1">
      <Dependency Name="r2" />
      <Dependency Name="y1" />
    </PointByCoordinates>
    <PointByCoordinates Name="p20" Visible="false" X="r2" Y="y1">
      <Dependency Name="r2" />
      <Dependency Name="y1" />
    </PointByCoordinates>
    <PointByCoordinates Name="p21" Visible="false" X="H.X" Y="y1">
      <Dependency Name="H" />
      <Dependency Name="y1" />
    </PointByCoordinates>
    <Polygon Name="poly22" Style="Rectangle" Z="1">
      <Dependency Name="p18" />
      <Dependency Name="p19" />
      <Dependency Name="p20" />
      <Dependency Name="p21" />
    </Polygon>
    <PointByCoordinates Name="p23" Visible="false" X="-r3" Y="-y2">
      <Dependency Name="r3" />
      <Dependency Name="y2" />
    </PointByCoordinates>
    <PointByCoordinates Name="p24" Visible="false" X="-H.X" Y="-y2">
      <Dependency Name="H" />
      <Dependency Name="y2" />
    </PointByCoordinates>
    <PointByCoordinates Name="p25" Visible="false" X="-H.X" Y="y2">
      <Dependency Name="H" />
      <Dependency Name="y2" />
    </PointByCoordinates>
    <PointByCoordinates Name="p26" Visible="false" X="-r3" Y="y2">
      <Dependency Name="r3" />
      <Dependency Name="y2" />
    </PointByCoordinates>
    <Polygon Name="poly27" Style="Rectangle" Z="1">
      <Dependency Name="p23" />
      <Dependency Name="p24" />
      <Dependency Name="p25" />
      <Dependency Name="p26" />
    </Polygon>
  </Figures>
</Drawing>
