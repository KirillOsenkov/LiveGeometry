      <Dependency Name="n10" />
      <Dependency Name="B" />
      <Dependency Name="n9" />
    </PointByCoordinates>
    <Number Name="n11" Formula="((B.X - A.X) * (P.Y - B.Y) - 1 * (B.Y - A.Y) * (P.X - B.X)) / (((Q.X - A.X) * (P.Y - B.Y) - 1 * (Q.Y - A.Y) * (P.X - B.X)))">
      <Dependency Name="B" />
      <Dependency Name="A" />
      <Dependency Name="P" />
      <Dependency Name="Q" />
    </Number>
    <PointByCoordinates Name="X" Visible="false" X="(A.X + n11 * (Q.X - A.X))" Y="(A.Y + n11 * (Q.Y - A.Y))">
      <Dependency Name="A" />
      <Dependency Name="n11" />
      <Dependency Name="Q" />
    </PointByCoordinates>
