      <Dependency Name="p4" />
      <Dependency Name="p5" />
    </Segment>
    <PointOnFigure Name="T" Style="Handle" X="2" Y="5.74" Parameter="0.5">
      <Dependency Name="track6" />
    </PointOnFigure>
    <Number Name="r" Formula="T.Y - C.Y">
      <Dependency Name="T" />
      <Dependency Name="C" />
    </Number>
    <Number Name="dc" Formula="sqrt(C.X ^ 2 + C.Y ^ 2)">
      <Dependency Name="C" />
    </Number>
    <Number Name="al" Formula="(16 - r ^ 2 + dc ^ 2) / (2 * dc)">
      <Dependency Name="r" />
      <Dependency Name="dc" />
    </Number>
    <Number Name="ac" Formula="sqrt(16 - al ^ 2)">
      <Dependency Name="al" />
    </Number>
    <PointByCoordinates Name="E" Visible="false" X="(al * C.X / dc - ac * C.Y / dc)" Y="(al * C.Y / dc + ac * C.X / dc)">
      <Dependency Name="al" />
      <Dependency Name="C" />
      <Dependency Name="dc" />
      <Dependency Name="ac" />
    </PointByCoordinates>
    <PointByCoordinates Name="F" Visible="false" X="(al * C.X / dc + ac * C.Y / dc)" Y="(al * C.Y / dc - 1 * ac * C.X / dc)">
      <Dependency Name="al" />
      <Dependency Name="C" />
      <Dependency Name="dc" />
      <Dependency Name="ac" />
    </PointByCoordinates>
    <Number Name="n7" Formula="sqrt((E.X - A.X) ^ 2 + (E.Y - A.Y) ^ 2)">
      <Dependency Name="E" />
      <Dependency Name="A" />
    </Number>
    <Number Name="n8" Formula="-2 * ((E.X - C.X) * (E.X - A.X) / n7 + (E.Y - C.Y) * (E.Y - A.Y) / n7)">
