      <Dependency Name="C" />
      <Dependency Name="A" />
      <Dependency Name="n7" />
    </Number>
    <PointByCoordinates Name="P" Visible="false" X="(E.X + n8 * ((E.X - A.X) / n7))" Y="(E.Y + n8 * ((E.Y - A.Y) / n7))">
      <Dependency Name="E" />
      <Dependency Name="n8" />
      <Dependency Name="A" />
      <Dependency Name="n7" />
    </PointByCoordinates>
    <Number Name="n9" Formula="sqrt((F.X - B.X) ^ 2 + (F.Y - B.Y) ^ 2)">
      <Dependency Name="F" />
      <Dependency Name="B" />
    </Number>
    <Number Name="n10" Formula="-2 * ((F.X - C.X) * (F.X - B.X) / n9 + (F.Y - C.Y) * (F.Y - B.Y) / n9)">
