<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn by hand (not by tools/catrionadrawings.cs): the maintainer's ruler-and-compass construction with the library's styles.
     Four congruent squares in a rectangle. The handle G slides along AB, a side of the second square: the third square
     stands on G, its corner H a side further along the first two squares' bottom (a circle of the side's radius cut by the
     parallel to AD), the fourth on top of it, and the rectangle is fitted to the corners (the bottom through A and H, the
     sides across it through F and K, the top through L). A line from the bottom left corner M through C; the angle it
     makes with the top is 45° wherever G is. With G at A the line is the first square's diagonal and ends at a corner of
     the fourth; with G at B it runs along the squares' sides. The squares stay put and the rectangle turns with G: level
     in the middle of the range, up to 22.5° either way. -->
<Drawing Version="1">
  <Viewport Left="-1.2136" Top="5.2236" Right="9.5936" Bottom="-3.2836" />
  <Scene Left="-1.2136" Top="5.2236" Right="9.5936" Bottom="-3.2836" />
  <Styles>
    <PointStyle Name="Handle" Size="15" Fill="#FFFFFFFF" Color="#FF1E1E1E" StrokeWidth="2.5">
      <Dark Fill="#FF1E2228" Color="#FFF2F2F2" />
    </PointStyle>
    <ShapeStyle Name="Pink" Color="#FF4A2441" StrokeWidth="2.5" Fill="#FFFEC2CC" Texture="FeltTip">
      <Dark Color="#FFE8B0DB" Texture="None">
        <Fill>
          <LinearGradientBrush>
            <GradientStop Color="#FFD77485" />
            <GradientStop Color="#FFB85666" Offset="1" />
          </LinearGradientBrush>
        </Fill>
      </Dark>
    </ShapeStyle>
    <ShapeStyle Name="Frame" Color="#FF4A2441" StrokeWidth="2.5" IsFilled="false">
      <Dark Color="#FFE8B0DB" />
    </ShapeStyle>
    <LineStyle Name="PinkLine" Color="#FFEA4182" StrokeWidth="2.5">
      <Dark Color="#FFF5A3C3" />
    </LineStyle>
    <TextStyle Name="PinkMark" FontSize="28" Color="#FFEA4182" FontFamily="Segoe UI" Bold="true">
      <Dark Color="#FFF5A3C3" />
    </TextStyle>
    <PointStyle Name="Anchor" Size="1" Fill="#00000000" Color="#00000000" StrokeWidth="0" />
  </Styles>
  <Figures>
    <FreePoint Name="A" Visible="false" X="3.69551813" Y="-1.5307337295" />
    <FreePoint Name="B" Visible="false" X="4.4608849948" Y="0.3170253356" />
    <PointByCoordinates Name="C" Visible="false" X="A.Y + B.X - B.Y" Y="-A.X + B.X + B.Y">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </PointByCoordinates>
    <PointByCoordinates Name="D" Visible="false" X="A.X + A.Y - B.Y" Y="-A.X + A.Y + B.X">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </PointByCoordinates>
    <Segment Name="AB" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </Segment>
    <Segment Name="AD" Visible="false">
      <Dependency Name="D" />
      <Dependency Name="A" />
    </Segment>
    <Polygon Name="ABCD" Style="Pink">
      <Dependency Name="A" />
      <Dependency Name="B" />
      <Dependency Name="C" />
      <Dependency Name="D" />
    </Polygon>
    <PointByCoordinates Name="E" Visible="false" X="C.X - C.Y + D.Y" Y="C.X + C.Y - D.X">
      <Dependency Name="C" />
      <Dependency Name="D" />
    </PointByCoordinates>
    <PointByCoordinates Name="F" Visible="false" X="-C.Y + D.X + D.Y" Y="C.X - D.X + D.Y">
      <Dependency Name="C" />
      <Dependency Name="D" />
    </PointByCoordinates>
    <Polygon Name="CDFE" Style="Pink">
      <Dependency Name="D" />
      <Dependency Name="C" />
      <Dependency Name="E" />
      <Dependency Name="F" />
    </Polygon>
    <PointOnFigure Name="G" Style="Handle" X="4.0125434656" Y="-0.7653668647" Parameter="0.4142135624">
      <Dependency Name="AB" />
    </PointOnFigure>
    <ParallelLine Name="g" Visible="false">
      <Dependency Name="AD" />
      <Dependency Name="G" />
    </ParallelLine>
    <CircleByRadius Name="c" Visible="false">
      <Dependency Name="E" />
      <Dependency Name="C" />
      <Dependency Name="G" />
    </CircleByRadius>
    <IntersectionPoint Name="H" Visible="false" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="g" />
      <Dependency Name="c" />
    </IntersectionPoint>
    <PointByCoordinates Name="I" Visible="false" X="G.Y + H.X - H.Y" Y="-G.X + H.X + H.Y">
      <Dependency Name="G" />
      <Dependency Name="H" />
    </PointByCoordinates>
    <PointByCoordinates Name="J" Visible="false" X="G.X + G.Y - H.Y" Y="-G.X + G.Y + H.X">
      <Dependency Name="G" />
      <Dependency Name="H" />
    </PointByCoordinates>
    <Polygon Name="GHIJ" Style="Pink">
      <Dependency Name="G" />
      <Dependency Name="H" />
      <Dependency Name="I" />
      <Dependency Name="J" />
    </Polygon>
    <PointByCoordinates Name="K" Visible="false" X="I.X - I.Y + J.Y" Y="I.X + I.Y - J.X">
      <Dependency Name="I" />
      <Dependency Name="J" />
    </PointByCoordinates>
    <PointByCoordinates Name="L" Visible="false" X="-I.Y + J.X + J.Y" Y="I.X - J.X + J.Y">
      <Dependency Name="I" />
      <Dependency Name="J" />
    </PointByCoordinates>
    <Polygon Name="IJLK" Style="Pink">
      <Dependency Name="J" />
      <Dependency Name="I" />
      <Dependency Name="K" />
      <Dependency Name="L" />
    </Polygon>
    <LineTwoPoints Name="AH" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="H" />
    </LineTwoPoints>
    <PerpendicularLine Name="h" Visible="false" RightAngleCorner="1">
      <Dependency Name="AH" />
      <Dependency Name="K" />
    </PerpendicularLine>
    <PerpendicularLine Name="k" Visible="false" RightAngleCorner="0">
      <Dependency Name="AH" />
      <Dependency Name="F" />
    </PerpendicularLine>
    <ParallelLine Name="m" Visible="false">
      <Dependency Name="AH" />
      <Dependency Name="L" />
    </ParallelLine>
    <IntersectionPoint Name="M" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="AH" />
      <Dependency Name="k" />
    </IntersectionPoint>
    <LineTwoPoints Name="CM" Visible="false">
      <Dependency Name="M" />
      <Dependency Name="C" />
    </LineTwoPoints>
    <IntersectionPoint Name="N" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="m" />
      <Dependency Name="CM" />
    </IntersectionPoint>
    <IntersectionPoint Name="O" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="k" />
      <Dependency Name="m" />
    </IntersectionPoint>
    <IntersectionPoint Name="P" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="h" />
      <Dependency Name="m" />
    </IntersectionPoint>
    <IntersectionPoint Name="Q" Visible="false" Algorithm="IntersectLineAndLine">
      <Dependency Name="AH" />
      <Dependency Name="h" />
    </IntersectionPoint>
    <Polygon Name="MOPQ" Style="Frame">
      <Dependency Name="O" />
      <Dependency Name="P" />
      <Dependency Name="Q" />
      <Dependency Name="M" />
    </Polygon>
    <Segment Name="MN" Style="PinkLine">
      <Dependency Name="N" />
      <Dependency Name="M" />
    </Segment>
    <AngleArc Name="AngleArc1" Style="PinkLine" Radius="40">
      <Dependency Name="N" />
      <Dependency Name="O" />
      <Dependency Name="M" />
    </AngleArc>
    <!-- the question mark on the angle's bisector, half a side from N: a point there is attached to, shown in a style that draws nothing -->
    <AngleBisector Name="bisector" Visible="false">
      <Dependency Name="N" />
      <Dependency Name="O" />
      <Dependency Name="M" />
    </AngleBisector>
    <MidPoint Name="Half" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="B" />
    </MidPoint>
    <CircleByRadius Name="reach" Visible="false">
      <Dependency Name="A" />
      <Dependency Name="Half" />
      <Dependency Name="N" />
    </CircleByRadius>
    <IntersectionPoint Name="At" Style="Anchor" Algorithm="IntersectLineAndEllipse2">
      <Dependency Name="bisector" />
      <Dependency Name="reach" />
    </IntersectionPoint>
    <AttachedLabel Name="Mark" Style="PinkMark" Z="1" OffsetX="-11.06" OffsetY="-19.55" Text="?">
      <Dependency Name="At" />
    </AttachedLabel>
  </Figures>
</Drawing>
